---
import {
	LIBRARY_HREF,
	isSection,
	normalizePath,
	topicHref,
	topicLinks,
	type NavLink,
	type NavLocation,
	type NavTopic,
} from '../../navigation';

type Props = {
	topics: NavTopic[];
	location?: NavLocation;
};

const { topics, location } = Astro.props as Props;
const current = normalizePath(Astro.url.pathname);
const topic = location?.topic;
const index = topic && topicLinks(topic).find((link) => link.link === topic.base);
const chapterCount = topic ? topicLinks(topic).filter((link) => link !== index).length : 0;

const isCurrent = (link: NavLink) => link.link === current;
const href = (link: NavLink) => `/${link.link}`;

// 목차 링크는 따로 위에 두고, 나머지는 번호를 붙여 보여 준다.
const entries = topic ? topic.items.filter((item) => isSection(item) || item !== index) : [];
---

<nav id="site-nav" class="site-nav" aria-label={topic ? `${topic.label} 목차` : '자료실'}>
	{
		topic ? (
			<>
				<a class="library-link" href={LIBRARY_HREF}>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M15 6l-6 6 6 6" />
					</svg>
					자료실 · 다른 자료 보기
				</a>
				<p class="topic-title">{topic.label}</p>
				<p class="topic-meta">{chapterCount}개 문서</p>
				{index && (
					<a class="topic-index" href={href(index)} aria-current={isCurrent(index) ? 'page' : undefined}>
						목차
					</a>
				)}

				<div class="entries">
					{entries.map((item) => {
						if (!isSection(item)) {
							return null;
						}
						// 장이 하나뿐인 섹션은 섹션 이름 자체를 그 장으로 가는 링크로 둔다.
						if (item.items.length === 1) {
							const only = item.items[0]!;
							return (
								<a class:list={['section-head', { 'is-current': isCurrent(only) }]} href={href(only)} aria-current={isCurrent(only) ? 'page' : undefined}>
									{item.section}
								</a>
							);
						}
						const open = item.items.some(isCurrent);
						return (
							<details class:list={['section', { 'is-current': open }]} open={open}>
								<summary class="section-head">
									{item.section}
									<span class="count">{item.items.length}</span>
								</summary>
								<ol class="chapters">
									{item.items.map((link, i) => (
										<li>
											<a href={href(link)} aria-current={isCurrent(link) ? 'page' : undefined}>
												<span class="no">{i + 1}</span>
												{link.text}
											</a>
										</li>
									))}
								</ol>
							</details>
						);
					})}

					{entries.some((item) => !isSection(item)) && (
						<ol class="chapters chapters--flat">
							{entries
								.filter((item): item is NavLink => !isSection(item))
								.map((link, i) => (
									<li>
										<a href={href(link)} aria-current={isCurrent(link) ? 'page' : undefined}>
											<span class="no">{i + 1}</span>
											{link.text}
										</a>
									</li>
								))}
						</ol>
					)}
				</div>
			</>
		) : (
			<p class="topic-title">자료실</p>
		)
	}

	<details class="library" open={!topic}>
		<summary class="section-head">
			{topic ? '다른 자료' : '모든 자료'}
			<span class="count">{topics.length}</span>
		</summary>
		<ol class="chapters">
			{
				topics.map((other) => (
					<li>
						<a href={topicHref(other)} aria-current={other === topic ? 'true' : undefined}>
							{other.label}
						</a>
					</li>
				))
			}
		</ol>
	</details>
</nav>

<style>
	.site-nav {
		padding: 1.5rem 1.25rem 3rem 1.75rem;
		font-size: 0.875rem;
	}

	.library-link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0 0 1.125rem -0.375rem;
		padding: 0.375rem 0.5rem 0.375rem 0.375rem;
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.library-link:hover {
		background: var(--surface);
		color: var(--text);
	}

	.topic-title {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.25rem;
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.topic-meta {
		margin: 0.25rem 0 0.75rem;
		font-size: 0.78125rem;
		color: var(--muted);
	}

	.topic-index {
		display: block;
		margin: 0 -0.625rem 0.75rem;
		padding: 0.375rem 0.625rem;
		font-weight: 700;
	}

	.topic-index:hover {
		background: var(--surface);
	}

	.topic-index[aria-current] {
		background: var(--surface-2);
	}

	.entries > * {
		border-top: 1px solid var(--rule);
	}

	.entries > :last-child {
		border-bottom: 1px solid var(--rule);
	}

	.entries > .chapters--flat {
		border: 0;
		padding-left: 0;
	}

	/* 섹션 머리: 굵게, 지금 섹션이 아니면 흐리게 */
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5625rem 0;
		font-weight: 700;
		color: var(--muted);
		cursor: pointer;
		list-style: none;
	}

	.section-head::-webkit-details-marker {
		display: none;
	}

	.section-head:hover,
	.section-head.is-current,
	.is-current > .section-head {
		color: var(--text);
	}

	.count {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-weight: 400;
		font-size: 0.75rem;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
	}

	.count::after {
		content: '';
		width: 0.375rem;
		height: 0.375rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(-45deg);
		transition: transform 0.15s;
	}

	details[open] > .section-head .count::after {
		transform: rotate(45deg) translate(-1px, -1px);
	}

	.is-current > .section-head .count {
		color: var(--accent);
	}

	/* 장: 들여쓰고 작게, 번호를 붙이고, 지금 장만 진하게 */
	.chapters {
		margin: -0.125rem 0 0.625rem;
		padding: 0 0 0 0.875rem;
		list-style: none;
	}

	.chapters li + li a {
		border-top: 1px solid var(--rule);
	}

	.chapters a {
		display: flex;
		gap: 0.625rem;
		padding: 0.3125rem 0;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--faint);
	}

	.chapters a:hover {
		color: var(--text);
	}

	.chapters a[aria-current] {
		color: var(--text);
		font-weight: 700;
	}

	.no {
		flex: none;
		width: 1.125rem;
		font-variant-numeric: tabular-nums;
	}

	.chapters a[aria-current] .no {
		color: var(--accent);
	}

	.library {
		margin-top: 2rem;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
</style>
