---
import MoreMenu from '../RightSidebar/MoreMenu.astro';
import TableOfContents from '../RightSidebar/TableOfContents';
import type { PairedBlock, ChapterHeading } from '../../utils/pairChapterBlocks';
import type { ChapterMeta } from '../../data/cypher-srd/chapters';

type Props = {
	titleEn: string;
	titleKo: string;
	rows: PairedBlock[];
	headings: ChapterHeading[];
	githubEditUrl: string;
	prev: ChapterMeta | null;
	next: ChapterMeta | null;
};

const { rows, headings, githubEditUrl, prev, next } = Astro.props as Props;
---

<article id="article" class="content bilingual-content">
	<section class="main-section">
		<div class="bilingual-lang-labels" aria-hidden="true">
			<span>English (원문)</span>
			<span>한국어 (번역)</span>
		</div>
		<nav class="block sm:hidden">
			<TableOfContents client:media="(max-width: 50em)" headings={headings} />
		</nav>
		{
			rows.map((row) => (
				<div class:list={['bilingual-row', `kind-${row.kind}`]}>
					<div class="en" set:html={row.enHtml} />
					<div class="ko" set:html={row.koHtml} />
				</div>
			))
		}
		{
			(prev || next) && (
				<nav class="chapter-nav" aria-label="챕터 이동">
					<a class:list={['chapter-nav-link', 'prev', { disabled: !prev }]} href={prev ? `/ko/cypher-srd/${prev.slug}` : undefined}>
						{prev ? `← ${prev.titleKo}` : ''}
					</a>
					<a class:list={['chapter-nav-link', 'next', { disabled: !next }]} href={next ? `/ko/cypher-srd/${next.slug}` : undefined}>
						{next ? `${next.titleKo} →` : ''}
					</a>
				</nav>
			)
		}
	</section>
	<nav class="block sm:hidden">
		<MoreMenu editHref={githubEditUrl} />
	</nav>
</article>

<style>
	.content {
		padding: 0;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.bilingual-content {
		max-width: 100%;
	}

	.content > section {
		margin-bottom: 4rem;
	}

	.block {
		display: block;
	}

	.bilingual-lang-labels {
		display: none;
	}

	.bilingual-row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.25rem 2rem;
		padding-block: 0.5rem;
	}

	.bilingual-row.kind-heading {
		padding-top: 1.5rem;
	}

	.bilingual-row .ko {
		border-top: 1px dashed var(--color-base-300, currentColor);
		padding-top: 0.5rem;
		opacity: 1;
	}

	.chapter-nav {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-base-300, currentColor);
	}

	.chapter-nav-link {
		flex: 1;
	}

	.chapter-nav-link.next {
		text-align: right;
	}

	.chapter-nav-link.disabled {
		visibility: hidden;
	}

	@media (min-width: 50em) {
		.sm\:hidden {
			display: none;
		}

		.bilingual-lang-labels {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			opacity: 0.6;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--color-base-300, currentColor);
			margin-bottom: 1rem;
			position: sticky;
			top: 0;
			background: var(--color-base-100, inherit);
			z-index: 1;
		}

		.bilingual-row {
			grid-template-columns: 1fr 1fr;
		}

		.bilingual-row .ko {
			border-top: none;
			border-left: 1px dashed var(--color-base-300, currentColor);
			padding-top: 0;
			padding-left: 2rem;
		}
	}
</style>
