---
import MobileToc from './MobileToc.astro';
import Pager from './Pager.astro';
import { SIDEBAR } from '../../config';
import { locate, neighbors, type Neighbor } from '../../navigation';
import type { PairedBlock, ChapterHeading } from '../../utils/pairChapterBlocks';

type NavChapter = { slug: string; titleKo: string };

type Props = {
	titleEn: string;
	titleKo: string;
	rows: PairedBlock[];
	headings: ChapterHeading[];
	prev: NavChapter | null;
	next: NavChapter | null;
	/** 메뉴에 없는 장일 때 이전/다음 장 링크의 기본 경로. 기본값은 사이퍼 SRD. */
	basePath?: string;
	/** true면 페이지 제목(영어 | 한국어)을 본문 맨 위에 렌더한다. */
	showTitle?: boolean;
	/** false면 한국어 열 없이 원문만 렌더한다(번역 전 장). */
	bilingual?: boolean;
	/** true면 "아직 번역하지 않았습니다" 안내를 보여 준다. */
	pendingNotice?: boolean;
	/** 번역 진행 상황 링크. 기본값은 던전월드 2 목차. */
	pendingNoticeHref?: string;
	/** 번역 진행 상황 링크의 이름. 기본값은 "던전월드 2 목차". */
	pendingNoticeLabel?: string;
	/** 안내문에서 가리킬 단위. 기본값은 "이 장". */
	pendingNoticeSubject?: string;
};

const {
	titleEn,
	titleKo,
	rows,
	headings,
	prev,
	next,
	basePath = '/ko/cypher-srd',
	showTitle = false,
	bilingual = true,
	pendingNotice = false,
	pendingNoticeHref = '/ko/awe/dw2',
	pendingNoticeLabel = '던전월드 2 목차',
	pendingNoticeSubject = '이 장',
} = Astro.props as Props;

const location = locate(SIDEBAR.ko, Astro.url.pathname);
const kicker = location?.section ?? location?.topic.label;

// 메뉴에 있는 장이면 메뉴 순서를, 아니면 넘겨받은 이전/다음 장을 쓴다.
const fromNav = neighbors(location);
const fromProps = (chapter: NavChapter | null): Neighbor | undefined =>
	chapter ? { href: `${basePath}/${chapter.slug}`, text: chapter.titleKo } : undefined;
const pager = location?.link ? fromNav : { prev: fromProps(prev), next: fromProps(next) };

// 앵커(<a id>)만 있는 덩어리는 화면에 보이는 글이 없으므로 이름표·여백을 붙이지 않는다.
const isBlank = (html: string) => html.replace(/<a\s+id="[^"]*"\s*><\/a>/g, '').trim() === '';

/*
	두 열에 같은 id가 있으면 문서에 id가 둘이 되어 #링크가 듣지 않는다. 한쪽 열에만 남기면 한 언어만
	보기에서 그 열이 숨겨질 때 다시 깨지므로, 겹치는 id는 두 열에서 지우고 행으로 옮긴다.
	헤딩 id는 행 자체의 id가 되고, 나머지 앵커는 행 맨 위에 둔다.
*/
const ID_RE = /\sid="([^"]*)"/g;
const idsOf = (html: string) => [...html.matchAll(ID_RE)].map((match) => match[1]!);
const escapeRe = (text: string) => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const stripIds = (html: string, ids: string[]) =>
	ids.reduce((out, id) => {
		const value = escapeRe(id);
		return out.replace(new RegExp(`<a\\s+id="${value}"\\s*></a>`, 'g'), '').replace(new RegExp(`\\sid="${value}"`, 'g'), '');
	}, html);
const decodeId = (id: string) => id.replace(/&quot;/g, '"').replace(/&amp;/g, '&');

const displayRows = rows.map((row) => {
	const koIds = new Set(bilingual ? idsOf(row.koHtml) : []);
	const shared = idsOf(row.enHtml).filter((id) => koIds.has(id));
	const moved = [...new Set([...shared, ...(row.id ? [row.id] : [])])];
	return {
		...row,
		blank: isBlank(row.enHtml) && isBlank(row.koHtml),
		enHtml: stripIds(row.enHtml, moved),
		koHtml: stripIds(row.koHtml, moved),
		anchors: moved.filter((id) => id !== row.id).map(decodeId),
	};
});
---

<article id="article" class="bilingual" data-view="both" data-bilingual={bilingual ? 'true' : 'false'}>
	<header class="bi-head">
		{kicker && <p class="kicker">{kicker}</p>}
		{
			showTitle && (
				<div class="bi-titles">
					<p class="bi-title" lang="en">
						{titleEn}
					</p>
					<h1 class="bi-title" id="overview">
						{titleKo}
					</h1>
				</div>
			)
		}
	</header>

	{
		pendingNotice && (
			<p class="pending-notice">
				{pendingNoticeSubject}은 아직 번역하지 않았습니다. 지금은 영어 원문만 보입니다. 진행 상황은{' '}
				<a href={pendingNoticeHref}>{pendingNoticeLabel}</a>에서 볼 수 있습니다.
			</p>
		)
	}

	{
		bilingual && (
			<div class="bi-toolbar no-print">
				<div class="bi-view" role="group" aria-label="보기 방식">
					<button type="button" data-view-option="both" aria-pressed="true">
						대역
					</button>
					<button type="button" data-view-option="en" aria-pressed="false">
						English
					</button>
					<button type="button" data-view-option="ko" aria-pressed="false">
						한국어
					</button>
				</div>
			</div>
		)
	}

	<MobileToc headings={headings} />

	{
		bilingual && (
			<div class="bi-row bi-labels" aria-hidden="true">
				<span class="en">ENGLISH · 원문</span>
				<span class="ko">한국어 · 번역</span>
			</div>
		)
	}

	{
		displayRows.map((row) => (
			<div
				id={row.id}
				class:list={['bi-row', `kind-${row.kind}`, row.gap && `gap-${row.gap}`, { 'is-blank': row.blank }]}
			>
				{row.anchors.map((id) => (
					<a id={id} class="bi-anchor" />
				))}
				<div class="en prose" lang="en" set:html={row.enHtml} />
				{bilingual && <div class="ko prose" set:html={row.koHtml} />}
			</div>
		))
	}

	<Pager prev={pager.prev} next={pager.next} />
</article>

<script>
	const STORAGE_KEY = 'bilingual-view';
	const VIEWS = ['both', 'en', 'ko'];

	function apply(article: HTMLElement, view: string) {
		article.dataset.view = view;
		for (const button of article.querySelectorAll<HTMLButtonElement>('[data-view-option]')) {
			button.setAttribute('aria-pressed', String(button.dataset.viewOption === view));
		}
	}

	for (const article of document.querySelectorAll<HTMLElement>('.bilingual[data-bilingual="true"]')) {
		let stored: string | null = null;
		try {
			stored = localStorage.getItem(STORAGE_KEY);
		} catch {
			// 저장소를 못 쓰면 기본값(대역)으로 둔다.
		}
		if (stored && VIEWS.includes(stored)) apply(article, stored);

		article.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-view-option]');
			if (!button?.dataset.viewOption) return;
			apply(article, button.dataset.viewOption);
			try {
				localStorage.setItem(STORAGE_KEY, button.dataset.viewOption);
			} catch {
				// 이번 페이지에서만 바뀐다.
			}
		});
	}
</script>

<style>
	.bi-head {
		margin-bottom: 1.25rem;
	}

	.bi-titles {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 3rem;
		padding-bottom: 1.125rem;
		border-bottom: 3px double var(--text);
	}

	.bi-title {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
		line-height: 1.25;
		letter-spacing: -0.03em;
	}

	.pending-notice {
		margin: 0 0 1.5rem;
		padding: 0.875rem 1.125rem;
		border-top: 2px solid var(--accent);
		background: var(--surface);
		font-size: 0.9375rem;
	}

	.pending-notice a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.bi-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin: 0 0 1.5rem;
	}

	/* 링크가 가리키는 앵커는 남겨 둔다. */
	.bi-row.is-blank {
		display: block;
		height: 0;
		overflow: hidden;
	}

	.bi-view {
		display: inline-flex;
		padding: 0.1875rem;
		background: var(--surface);
	}

	.bi-view button {
		min-height: 2.25rem;
		padding: 0 0.875rem;
		border: 0;
		background: transparent;
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.bi-view button[aria-pressed='true'] {
		background: var(--bg);
		color: var(--text);
		font-weight: 700;
	}

	.bi-row {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		column-gap: 3rem;
	}

	/* 두 열에서 옮겨 온 앵커. 격자 칸을 차지하지 않고 행 맨 위를 가리킨다. */
	.bi-anchor {
		position: absolute;
		top: 0;
	}

	.bi-labels {
		padding: 0.5rem 0;
		margin-bottom: 0.5rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--faint);
		border-bottom: 1px solid var(--rule);
	}

	/*
		원고의 절(또는 덩어리) 단위로 짝을 맞춘다. 각 열 안의 여백은 .prose가 맡고,
		제목이 아닌 덩어리만 앞 덩어리와 문단 간격을 띄운다.
	*/
	.bi-row .prose > :global(:first-child:not(h1, h2, h3, h4, h5, h6)) {
		margin-top: 0.875em;
	}

	.bi-row.kind-preamble .prose > :global(:first-child) {
		margin-top: 0;
	}

	/*
		절을 문단(덩어리) 단위 행으로 나눈 경우. 행마다 두 열의 높이가 같아져 문단 머리가 나란히
		선다. 격자 칸 안의 여백은 이웃 행과 겹치지(collapse) 않으므로, 칸 안 위아래 여백은 지우고
		한 열로 흐를 때 겹쳐서 남았을 간격을 행의 위 여백으로 준다.
	*/
	.bi-row:has(+ .bi-row.kind-block) .prose > :global(:last-child) {
		margin-bottom: 0;
	}

	.bi-row.kind-block .prose > :global(:first-child) {
		margin-top: 0;
	}

	.bi-row.kind-block {
		padding-top: 0.875em;
	}

	/* 인용(.prose blockquote)과 그림·카드 같은 HTML 상자는 문단보다 넓게 띄운다. */
	.bi-row.gap-quote {
		padding-top: 1.75em;
	}

	.bi-row.gap-html {
		padding-top: 1.5em;
	}

	/* 한 언어만 보기 */
	.bilingual[data-view='en'] .bi-row .ko,
	.bilingual[data-view='ko'] .bi-row .en {
		display: none;
	}

	.bilingual[data-view='en'] .bi-row,
	.bilingual[data-view='ko'] .bi-row,
	.bilingual[data-bilingual='false'] .bi-row {
		grid-template-columns: minmax(0, 1fr);
		max-width: var(--measure);
	}

	.bilingual[data-view='en'] .bi-labels,
	.bilingual[data-view='ko'] .bi-labels {
		display: none;
	}

	.bilingual[data-view='ko'] .bi-titles .bi-title[lang='en'] {
		display: none;
	}

	/* 좁은 화면: 문단마다 영어, 한국어 순으로 쌓는다. 두 언어는 같은 크기·같은 색이다. */
	@media (max-width: 60em) {
		.bi-titles {
			grid-template-columns: minmax(0, 1fr);
		}

		.bi-titles .bi-title + .bi-title {
			margin-top: 0.125rem;
		}

		.bi-row {
			grid-template-columns: minmax(0, 1fr);
		}

		.bi-labels {
			display: none;
		}

		.bilingual[data-view='both'][data-bilingual='true'] .bi-row:not(.bi-labels) {
			padding-bottom: 1rem;
			border-bottom: 1px solid var(--rule);
		}

		.bilingual[data-view='both'][data-bilingual='true'] .bi-row .prose::before {
			display: block;
			margin-top: 1rem;
			font-size: 0.65625rem;
			font-weight: 700;
			letter-spacing: 0.12em;
			color: var(--faint);
		}

		.bilingual[data-view='both'][data-bilingual='true'] .bi-row .en::before {
			content: 'EN';
		}

		.bilingual[data-view='both'][data-bilingual='true'] .bi-row .ko::before {
			content: 'KO';
		}

		/* 쌓을 때는 행마다 테두리로 나뉘므로 덩어리 행의 위 여백은 이름표가 맡는다. */
		.bilingual[data-view='both'][data-bilingual='true'] .bi-row.kind-block {
			padding-top: 0;
		}

		/* 쌓을 때는 이름표 바로 아래에서 시작한다. */
		.bilingual[data-view='both'][data-bilingual='true'] .bi-row .prose > :global(:first-child) {
			margin-top: 0.25em;
		}

		.bi-view {
			display: flex;
			width: 100%;
		}

		.bi-view button {
			flex: 1;
			min-height: 2.5rem;
		}
	}
</style>
