---
import type { Frontmatter } from '../../config';
import type { MarkdownHeading } from 'astro';
import { locate, neighbors } from '../../navigation';
import { SIDEBAR } from '../../config';
import MobileToc from './MobileToc.astro';
import Pager from './Pager.astro';

type Props = {
	frontmatter: Frontmatter;
	headings: MarkdownHeading[];
};

const { frontmatter, headings } = Astro.props as Props;
const location = locate(SIDEBAR.ko, Astro.url.pathname);
const kicker = location?.section ?? location?.topic.label;
const { prev, next } = neighbors(location);
---

<article id="article" class="page">
	<header class="page-head">
		{kicker && <p class="kicker">{kicker}</p>}
		<h1 class="page-title" id="overview">{frontmatter.title}</h1>
	</header>
	<MobileToc headings={headings} />
	<div class="prose">
		<slot />
	</div>
	<Pager prev={prev} next={next} />
</article>

<style>
	.page-head {
		padding-bottom: 1.125rem;
		margin-bottom: 2rem;
		border-bottom: 3px double var(--text);
	}

	.page-title {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
		line-height: 1.25;
		letter-spacing: -0.03em;
	}
</style>
