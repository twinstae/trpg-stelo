---
import type { Character } from './cypherCharacter';

interface Props {
  character: Readonly<Character>;
}

const { character } = Astro.props;
---

<div class="cypher-sheet">
  <div class="cs-column">
    <section class="cs-card cs-card--grow">
      <h3 class="cs-ribbon">특수 능력</h3>
      <ul class="cs-list">
        {
          character.specialAbilities.map((specialAbility) => (
            <li class="cs-list-item">
              <span class="cs-list-title">{specialAbility.title}</span>{' '}
              <span class="cs-list-desc">{specialAbility.description}</span>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="cs-card">
      <h3 class="cs-ribbon">사이퍼</h3>
      <p class="cs-note">
        사이퍼는 일회용 아이템입니다. 사용하고 나면 시트에서 사선을 그으십시오.
        걱정하지 마세요, 새로운 걸 더 찾게 될 겁니다.
      </p>
      <ul class="cs-list">
        {
          character.cyphers.map((cypher) => (
            <li class="cs-list-item">
              <span class="cs-list-title">{cypher.title}</span>{' '}
              <span class="cs-list-desc">{cypher.description}</span>{' '}
              <label class="cs-check">
                사용
                <input type="checkbox" class="cs-checkbox" />
              </label>
            </li>
          ))
        }
      </ul>
      <p class="cs-limit">
        제한 {character.cyphers.filter((c) => c.used === false).length} / {
          character.cypherLimit
        }
      </p>
    </section>
  </div>

  <div class="cs-column cs-column--center">
    <div class="cs-identity">
      <div class="cs-field cs-field--name">
        <span class="cs-field-label">이름</span>
        <div class="cs-field-value cs-field-value--name">{character.name}</div>
      </div>
      <div class="cs-identity-row">
        <div class="cs-field">
          <span class="cs-field-label">수식어</span>
          <div class="cs-field-value">{character.statement.descriptor}</div>
        </div>
        <div class="cs-field">
          <span class="cs-field-label">유형</span>
          <div class="cs-field-value">{character.statement.type}</div>
        </div>
      </div>
      <div class="cs-field">
        <span class="cs-field-label">특징</span>
        <div class="cs-field-value">{character.statement.focus}</div>
      </div>
      <div class="cs-background">
        {
          character.background
            .split('\n')
            .map((line) => <p>{line}</p>)
        }
      </div>
    </div>

    <ul class="cs-stats">
      <li class="cs-stat">
        <label class="cs-stat-current">
          <span class="cs-stat-label">힘</span>
          <input
            type="number"
            min="0"
            max={character.stats.might.pool}
            value={character.stats.might.current}
          />
        </label>
        <div class="cs-stat-sub">
          <label>
            <span>역량</span>
            <input type="number" min="0" value={character.stats.might.pool} />
          </label>
          <label>
            <span>재능</span>
            <input type="number" min="0" value={character.stats.might.edge} />
          </label>
        </div>
      </li>
      <li class="cs-stat">
        <label class="cs-stat-current">
          <span class="cs-stat-label">속력</span>
          <input
            type="number"
            min="0"
            max={character.stats.speed.pool}
            value={character.stats.speed.current}
          />
        </label>
        <div class="cs-stat-sub">
          <label>
            <span>역량</span>
            <input type="number" min="0" value={character.stats.speed.pool} />
          </label>
          <label>
            <span>재능</span>
            <input type="number" min="0" value={character.stats.speed.edge} />
          </label>
        </div>
      </li>
      <li class="cs-stat">
        <label class="cs-stat-current">
          <span class="cs-stat-label">지성</span>
          <input
            type="number"
            min="0"
            max={character.stats.intellect.pool}
            value={character.stats.intellect.current}
          />
        </label>
        <div class="cs-stat-sub">
          <label>
            <span>역량</span>
            <input
              type="number"
              min="0"
              value={character.stats.intellect.pool}
            />
          </label>
          <label>
            <span>재능</span>
            <input
              type="number"
              min="0"
              value={character.stats.intellect.edge}
            />
          </label>
        </div>
      </li>
    </ul>

    <div class="cs-meta-block">
      <div class="cs-meta-row">
        <label class="cs-meta-box">
          <span>등급</span>
          <input type="number" min="1" max="6" value="1" />
        </label>
        <label class="cs-meta-box">
          <span>분발</span>
          <input type="number" min="1" max="6" value="1" />
        </label>
        <label class="cs-meta-box">
          <span>경험치</span>
          <input type="number" min="0" max="16" value="0" />
        </label>
      </div>
      {
        character.stats.wounds && (
          <section class="cs-card">
            <h3 class="cs-ribbon cs-ribbon--tight">부상</h3>
            <p class="cs-note cs-note--wounds">
              중간 부상 마지막 칸: 방해 · 심각한 부상 마지막 칸: 사망
            </p>
            <ul class="cs-wounds">
              <li>
                <span class="cs-wounds-label">가벼운</span>
                <span class="cs-wounds-boxes">
                  {Array.from({ length: character.stats.wounds.light }).map(() => (
                    <input type="checkbox" class="cs-checkbox" />
                  ))}
                </span>
              </li>
              <li>
                <span class="cs-wounds-label">중간</span>
                <span class="cs-wounds-boxes">
                  {Array.from({ length: character.stats.wounds.medium }).map(() => (
                    <input type="checkbox" class="cs-checkbox" />
                  ))}
                </span>
              </li>
              <li>
                <span class="cs-wounds-label">심각한</span>
                <span class="cs-wounds-boxes">
                  {Array.from({ length: character.stats.wounds.severe }).map(() => (
                    <input type="checkbox" class="cs-checkbox" />
                  ))}
                </span>
              </li>
            </ul>
          </section>
        )
      }
      <section class="cs-card">
        <h3 class="cs-ribbon cs-ribbon--tight">회복</h3>
        <ul class="cs-recovery">
          <li>
            <label>
              <span>행동 하나</span>
              <input type="checkbox" class="cs-checkbox" />
            </label>
          </li>
          <li>
            <label>
              <span>10 분</span>
              <input type="checkbox" class="cs-checkbox" />
            </label>
          </li>
          <li>
            <label>
              <span>1시간</span>
              <input type="checkbox" class="cs-checkbox" />
            </label>
          </li>
          <li>
            <label>
              <span>10시간</span>
              <input type="checkbox" class="cs-checkbox" />
            </label>
          </li>
        </ul>
      </section>
    </div>
  </div>

  <div class="cs-column">
    <section class="cs-card">
      <h3 class="cs-ribbon">기능 / 무능</h3>
      <div class="cs-skills">
        <ul class="cs-list cs-list--skills">
          {
            character.skills
              .filter((skill) => skill.level !== 'inability')
              .map((skill) => (
                <li class="cs-skill-row">
                  <span>{skill.title}</span>
                  <span class="cs-skill-tag">
                    ({skill.level === 'trained' ? '익숙' : '능숙'})
                  </span>
                </li>
              ))
          }
        </ul>
        <ul class="cs-list cs-list--skills">
          {
            character.skills
              .filter((skill) => skill.level === 'inability')
              .map((skill) => (
                <li class="cs-skill-row">
                  <span>{skill.title}</span>
                  <span class="cs-skill-tag cs-skill-tag--inability">
                    (무능)
                  </span>
                </li>
              ))
          }
        </ul>
      </div>
    </section>
    <section class="cs-card">
      <h3 class="cs-ribbon">장비</h3>
      <ul class="cs-list">
        {
          character.equipments.map((equipment) => (
            <li class="cs-list-item">
              <span class="cs-list-title cs-list-title--plain">
                {equipment.title}
              </span>{' '}
              <span class="cs-list-desc">{equipment.description}</span>
            </li>
          ))
        }
      </ul>
      <label class="cs-shins">
        <input type="number" value={character.shins} />
        {character.currencyLabel ?? '쉰'}
      </label>
    </section>
    <section class="cs-card cs-card--grow">
      <h3 class="cs-ribbon">공격</h3>
      <p class="cs-note">
        공격을 하고 지근거리를 하나의 행동으로 움직일 수 있습니다.
      </p>
      <ul class="cs-list">
        {
          character.attacks.map((attack) => (
            <li class="cs-list-item">
              <span class="cs-list-title">{attack.title}</span>{' '}
              {attack.modifier !== 0 ? `(난이도 ${attack.modifier})` : null}{' '}
              <span class="cs-list-desc">{attack.damage} 피해. {attack.description}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</div>

<style>
  /*
    사이퍼 시스템(누메네라) 캐릭터 시트. 흰 종이에 먹색 한 가지로,
    면색·둥근 모서리 없이 굵은 제목과 가는 선으로만 구분한다.
    적어 넣는 칸(이름, 능력치, 체크 칸)만 선이나 테두리를 둔다.
  */
  .cypher-sheet {
    --cs-paper: #ffffff;
    --cs-ink: #141414;
    --cs-ink-soft: #5c5c5c;
    --cs-faint: #c9c9c9;

    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    background: var(--cs-paper);
    color: var(--cs-ink);
    font-family: var(--font-sans);
  }

  :global([data-theme="dark"]) .cypher-sheet {
    --cs-paper: #151515;
    --cs-ink: #f2f2f2;
    --cs-ink-soft: #a8a8a8;
    --cs-faint: #454545;
  }

  /* 화면에서 여러 캐릭터를 이어 볼 때 사이를 띄운다. */
  .cypher-sheet + .cypher-sheet {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 3px double var(--cs-ink);
  }

  @media (min-width: 1024px) {
    .cypher-sheet {
      flex-direction: row;
      gap: 1.75rem;
    }
  }

  .cs-column {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-width: 0;
    text-align: left;
  }

  @media (min-width: 1024px) {
    .cs-column {
      flex: 1 1 0;
    }
  }

  /* 섹션 머리: 세리프 굵은 글씨 + 가는 밑줄 */
  .cs-ribbon {
    margin: 0 0 0.5rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--cs-ink);
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  /* 이름 · 수식어 · 유형 · 특징 */
  .cs-field {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-bottom: 0.6rem;
  }

  .cs-field-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--cs-ink-soft);
  }

  .cs-field-value {
    padding: 0.1rem 0 0.2rem;
    border-bottom: 1px solid var(--cs-ink);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .cs-field-value--name {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .cs-identity-row {
    display: flex;
    gap: 1rem;
  }

  .cs-identity-row .cs-field {
    flex: 1;
    min-width: 0;
  }

  .cs-background {
    margin-top: 0.5rem;
  }

  .cs-background p {
    margin: 0 0 0.35rem;
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--cs-ink-soft);
  }

  /* 능력치: 적어 넣는 칸이라 가는 테두리만 둔다. */
  .cs-stats {
    display: flex;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cs-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--cs-ink);
  }

  .cs-stat-current {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.4rem 0.25rem 0.2rem;
  }

  .cs-stat-label,
  .cs-meta-box span {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .cs-stat-current input {
    width: 100%;
    font-family: var(--font-serif);
    font-size: 1.9rem;
    font-weight: 700;
    text-align: center;
  }

  .cs-stat-sub {
    display: flex;
    border-top: 1px solid var(--cs-faint);
  }

  .cs-stat-sub label {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.2rem 0.1rem 0.25rem;
  }

  .cs-stat-sub label:first-child {
    border-right: 1px solid var(--cs-faint);
  }

  .cs-stat-sub label span {
    font-size: 0.58rem;
    color: var(--cs-ink-soft);
  }

  .cs-stat-sub input {
    width: 2rem;
    font-size: 0.95rem;
    font-weight: 700;
    text-align: center;
  }

  /* 등급 · 분발 · 경험치 */
  .cs-meta-block {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .cs-meta-row {
    display: flex;
    gap: 0.6rem;
  }

  .cs-meta-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.3rem 0.2rem;
    border: 1px solid var(--cs-ink);
  }

  .cs-meta-box input {
    width: 2.5rem;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    text-align: center;
  }

  .cs-note--wounds {
    margin-bottom: 0.35rem;
  }

  .cs-wounds {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cs-wounds li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .cs-wounds-label {
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .cs-wounds-boxes {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.2rem;
  }

  .cs-recovery {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cs-recovery label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .cs-recovery span {
    font-size: 0.65rem;
    white-space: nowrap;
  }

  /* 목록: 구분선 없이 간격으로 나눈다. */
  .cs-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cs-list-item {
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .cs-list-title {
    font-weight: 700;
  }

  .cs-note {
    margin: 0 0 0.45rem;
    font-size: 0.66rem;
    font-style: italic;
    color: var(--cs-ink-soft);
  }

  :global(:lang(ko)) .cs-note {
    font-style: normal;
  }

  .cs-check {
    float: right;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.5rem;
    font-size: 0.62rem;
    color: var(--cs-ink-soft);
    white-space: nowrap;
  }

  .cs-limit {
    margin-top: 0.5rem;
    text-align: right;
    font-size: 0.7rem;
    font-weight: 700;
  }

  /* 기능 · 무능 */
  .cs-skills {
    display: flex;
    gap: 1rem;
  }

  .cs-list--skills {
    width: 50%;
    gap: 0.2rem;
  }

  .cs-skill-row {
    display: flex;
    justify-content: space-between;
    gap: 0.3rem;
    font-size: 0.7rem;
  }

  .cs-skill-tag {
    font-size: 0.62rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .cs-skill-tag--inability {
    font-weight: 400;
    color: var(--cs-ink-soft);
  }

  .cs-shins {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.25rem;
    margin-top: 0.5rem;
    font-size: 0.75rem;
  }

  .cs-shins input {
    width: 2.5rem;
    border-bottom: 1px solid var(--cs-ink) !important;
    text-align: right;
    font-weight: 700;
  }

  /* 입력 칸 공통 */
  .cypher-sheet input[type='number'] {
    border: none;
    outline: none;
    background: transparent;
    color: var(--cs-ink);
    -moz-appearance: textfield;
  }

  .cypher-sheet input[type='number']::-webkit-outer-spin-button,
  .cypher-sheet input[type='number']::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cypher-sheet input:focus-visible {
    outline: 1px dashed var(--cs-ink);
    outline-offset: 1px;
  }

  .cs-checkbox {
    appearance: none;
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    margin: 0;
    border: 1.5px solid var(--cs-ink);
    border-radius: 0;
    background: transparent;
    vertical-align: middle;
    cursor: pointer;
  }

  .cs-checkbox:checked {
    background: var(--cs-ink);
  }

  .cs-recovery .cs-checkbox {
    width: 1rem;
    height: 1rem;
  }

  /* 인쇄: 캐릭터마다 A4 가로 한 장, 세 단 그대로 */
  @page cypher-sheet {
    size: A4 landscape;
    margin: 9mm 10mm;
  }

  @media print {
    :global(:root:has(.cypher-sheet)) {
      font-size: 12px;
    }

    .cypher-sheet {
      page: cypher-sheet;
      flex-direction: row;
      gap: 1.5rem;
      break-after: page;
    }

    .cypher-sheet + .cypher-sheet {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .cs-column {
      flex: 1 1 0;
    }
  }
</style>
