---
import '../styles/index.css';
import { STORAGE_KEY } from '../utils/theme';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<link rel="sitemap" href="/sitemap.xml" />

<!-- 본문 글꼴 Pretendard (제목용 마루부리는 styles/fonts.css) -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link
	rel="stylesheet"
	href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>

<!-- Scrollable a11y code helper -->
<script src="/make-scrollable-code-focusable.js" is:inline></script>

<!-- 깜빡임 없이 저장된 테마(없으면 운영체제 설정)를 먼저 적용한다. -->
<script is:inline define:vars={{ STORAGE_KEY }}>
	let stored = null;
	try {
		stored = localStorage.getItem(STORAGE_KEY);
	} catch (e) {
		/* storage blocked */
	}
	const isDark = stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
	document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
</script>
