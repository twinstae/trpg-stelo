---
import '../styles/theme.css';
import '../styles/index.css';
import { DAISY_THEMES, STORAGE_KEY } from '../utils/theme';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<link rel="sitemap" href="/sitemap.xml" />

<!-- Preload Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Scrollable a11y code helper -->
<script src="/make-scrollable-code-focusable.js" is:inline>

</script>

<!-- This is intentionally inlined to avoid FOUC -->
<script is:inline define:vars={{ DAISY_THEMES, STORAGE_KEY }}>
	const root = document.documentElement;
	let stored = null;
	try {
		stored = localStorage.getItem(STORAGE_KEY);
	} catch (e) {
		/* storage blocked */
	}
	const isDark = stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
	root.classList.toggle('theme-dark', isDark);
	root.setAttribute('data-theme', isDark ? DAISY_THEMES.dark : DAISY_THEMES.light);
</script>

