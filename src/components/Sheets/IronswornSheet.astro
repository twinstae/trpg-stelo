---
import type { IronswornSheetLayout } from './ironswornSheet';
import { IRONSWORN_SHEET } from '../../data/ironsworn/sheet';

interface Props {
  sheet?: Readonly<IronswornSheetLayout>;
}

const { sheet = IRONSWORN_SHEET } = Astro.props;

/** 트랙 값은 부호를 살린다: +6, -2, 0. */
const signed = (value: number) => (value > 0 ? `+${value}` : `${value}`);

const pageRange = (count: number) => Array.from({ length: count });
---

<article class="iw-sheet" data-iw-sheet="character" aria-label="철의 맹세 캐릭터 시트">
  <!-- ───────────── 머리말 ───────────── -->
  <header class="iw-head">
    <label class="iw-field" data-sheet-section="캐릭터">
      <span class="iw-tag">캐릭터 <em>Character</em></span>
      <input type="text" class="iw-input iw-input--name" aria-label="캐릭터 이름" />
    </label>

    <div class="iw-experience" data-sheet-section="경험">
      <span class="iw-tag">경험 <em>Experience</em></span>
      <div class="iw-bubbles">
        {
          pageRange(sheet.experienceRows).map((_, row) => (
            <span class="iw-bubble-row">
              {pageRange(sheet.experiencePerRow).map((_, column) => (
                <input
                  type="checkbox"
                  class="iw-tick iw-tick--round"
                  aria-label={`경험 ${row * sheet.experiencePerRow + column + 1}`}
                />
              ))}
            </span>
          ))
        }
      </div>
    </div>
  </header>

  <div class="iw-body">
    <!-- ───────────── 모멘텀 ───────────── -->
    <section class="iw-momentum" data-sheet-section="모멘텀">
      {/* 눈에는 숫자만 보이지만, 화면 낭독기에는 이 칸의 이름이 필요하다. */}
      <h3 class="iw-sr">모멘텀 트랙</h3>
      <ul class="iw-ladder">
        {
          sheet.momentum.map((value) => (
            <li>
              <label class="iw-cell">
                <input
                  type="radio"
                  class="iw-sr"
                  name="iw-momentum"
                  aria-label={`모멘텀 ${signed(value)}`}
                />
                <span class="iw-cell-value">{signed(value)}</span>
              </label>
            </li>
          ))
        }
      </ul>
      <div class="iw-ladder-foot">
        <label class="iw-foot">
          <input
            type="number"
            class="iw-input iw-input--number"
            value={sheet.maxMomentum}
            aria-label="최대 모멘텀"
          />
          <span>최대 <em>Max</em></span>
        </label>
        <label class="iw-foot">
          <input
            type="number"
            class="iw-input iw-input--number"
            value={sheet.momentumReset}
            aria-label="모멘텀 초기화"
          />
          <span>초기화 <em>Reset</em></span>
        </label>
      </div>
    </section>

    <!-- ───────────── 가운데 ───────────── -->
    <div class="iw-center">
      <section class="iw-stats" data-sheet-section="능력치">
        {
          sheet.stats.map((stat) => (
            <label class="iw-stat">
              <input type="number" class="iw-input iw-stat-value" aria-label={stat.label} />
              <span class="iw-stat-name">{stat.label}</span>
              <span class="iw-stat-name-en">{stat.labelEn}</span>
            </label>
          ))
        }
      </section>

      <section class="iw-block" data-sheet-section="유대">
        <h3 class="iw-rule-title">유대 <em>Bonds</em></h3>
        <div class="iw-bonds">
          {
            pageRange(sheet.bonds).map((_, index) => (
              <input
                type="checkbox"
                class="iw-tick"
                aria-label={`유대 ${index + 1}`}
              />
            ))
          }
        </div>
        <p class="iw-hint">
          뜻깊은 시간을 보내거나 함께 난관에 맞선 뒤 유대 맺기를 하고, 유대 진행 트랙의 칸을
          채울 때마다 여기에 표시하십시오.
        </p>
      </section>

      <section class="iw-block" data-sheet-section="맹세">
        <h3 class="iw-rule-title">맹세 <em>Vows</em></h3>
        <ul class="iw-vows">
          {
            pageRange(sheet.vows).map((_, index) => (
              <li class="iw-vow">
                <label class="iw-vow-name">
                  <input
                    type="text"
                    class="iw-input"
                    aria-label={`맹세 ${index + 1} 이름`}
                    placeholder={`맹세 ${index + 1}`}
                  />
                </label>
                <div class="iw-ranks">
                  {sheet.ranks.map((rank) => (
                    <label class="iw-rank">
                      <input
                        type="radio"
                        class="iw-tick iw-tick--round"
                        name={`iw-vow-rank-${index + 1}`}
                        aria-label={`맹세 ${index + 1} ${rank.label}`}
                        title={`${rank.label} — ${rank.progress}`}
                      />
                      <span>{rank.label}</span>
                    </label>
                  ))}
                </div>
                <div class="iw-progress">
                  {pageRange(sheet.vowProgress).map((_, box) => (
                    <input
                      type="checkbox"
                      class="iw-tick"
                      aria-label={`맹세 ${index + 1} 진척 ${box + 1}`}
                    />
                  ))}
                </div>
              </li>
            ))
          }
        </ul>
        <p class="iw-hint">
          등급에 따라 이정표마다 표시하는 진척이 다릅니다. {sheet.ranks
            .map((rank) => `${rank.label} ${rank.progress.replace('경유지마다 ', '')}`)
            .join(' · ')}.
        </p>
      </section>

      <section class="iw-block" data-sheet-section="결점">
        <h3 class="iw-rule-title">결점 <em>Debilities</em></h3>
        <div class="iw-debilities">
          <div class="iw-debility-group">
            <h4 class="iw-debility-title">조건 <em>Conditions</em></h4>
            <ul>
              {
                sheet.conditions.map((debility) => (
                  <li>
                    <label class="iw-debility">
                      <input
                        type="checkbox"
                        class="iw-tick iw-tick--round"
                        aria-label={debility.label}
                      />
                      <span>{debility.label}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="iw-debility-group">
            <h4 class="iw-debility-title">재앙 <em>Banes</em></h4>
            <ul>
              {
                sheet.banes.map((debility) => (
                  <li>
                    <label class="iw-debility">
                      <input
                        type="checkbox"
                        class="iw-tick iw-tick--round"
                        aria-label={debility.label}
                      />
                      <span>{debility.label}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="iw-debility-group">
            <h4 class="iw-debility-title">부담 <em>Burdens</em></h4>
            <ul>
              {
                sheet.burdens.map((debility) => (
                  <li>
                    <label class="iw-debility">
                      <input
                        type="checkbox"
                        class="iw-tick iw-tick--round"
                        aria-label={debility.label}
                      />
                      <span>{debility.label}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>
    </div>

    <!-- ───────────── 상태 ───────────── -->
    <section class="iw-status" data-sheet-section="상태">
      <h3 class="iw-sr">상태 트랙</h3>
      {
        sheet.statusTracks.map((track) => (
          <div class="iw-status-track">
            <h4 class="iw-status-title" title={track.note}>
              {track.label} <em>{track.labelEn}</em>
            </h4>
            <ul class="iw-ladder iw-ladder--status">
              {sheet.status.map((value) => (
                <li>
                  <label class="iw-cell">
                    <input
                      type="radio"
                      class="iw-sr"
                      name={`iw-status-${track.id}`}
                      aria-label={`${track.label} ${signed(value)}`}
                    />
                    <span class="iw-cell-value">{signed(value)}</span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>

  <!-- ───────────── 아래 띠 ───────────── -->
  <footer class="iw-wordmark">
    <svg class="iw-ridge" viewBox="0 0 600 24" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M0 24 L0 15 L12 8 L24 14 L38 5 L50 12 L64 7 L78 15 L92 10 L106 16 L118 9 L132 15 L146 6 L160 13 L174 8 L188 15 L202 10 L216 16 L230 7 L244 14 L258 9 L272 15 L286 6 L300 13 L314 8 L328 15 L342 10 L356 16 L370 9 L384 14 L398 6 L412 13 L426 8 L440 15 L454 10 L468 16 L482 11 L496 15 L510 7 L524 13 L538 8 L552 15 L566 11 L580 14 L590 9 L600 12 L600 24 Z"
      ></path>
    </svg>
    <span class="iw-side-word" title="Momentum">모멘텀</span>
    <span class="iw-wordmark-text">IRONSWORN</span>
    <span class="iw-side-word" title="Status">상태</span>
  </footer>
</article>

<ul class="iw-notes">
  {sheet.notes.map((note) => <li>{note}</li>)}
</ul>

<script>
  import { persistSheet, wireClearableChoices } from '../../utils/sheetStorage';

  document.querySelectorAll<HTMLElement>('[data-iw-sheet="character"]').forEach((sheet) => {
    persistSheet(sheet, { prefix: 'iw-sheet:v1:', key: 'character' });
    // 트랙은 값 하나만 표시한다. 표시된 값을 다시 누르면 지워진다.
    wireClearableChoices(sheet, 'input[type="radio"]');
  });
</script>

<style is:global>
  .iw-sheet {
    /* 인쇄용 시트처럼 흰 종이에 검은 잉크만 쓴다. */
    --iw-paper: #ffffff;
    --iw-paper-soft: #e4e4e4;
    --iw-ink: #141414;
    --iw-ink-soft: #5f5f5f;
    --iw-rule: #141414;
    --iw-rule-soft: color-mix(in oklab, var(--iw-rule) 32%, transparent);
    --iw-faint: #b9b9b9;

    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
    padding: 0.7rem 0.8rem 0.8rem;
    background: var(--iw-paper);
    color: var(--iw-ink);
    font-family: var(--font-body);
    border: 2px solid var(--iw-rule);
    border-radius: 2px;
  }

  .theme-dark .iw-sheet {
    --iw-paper: #141414;
    --iw-paper-soft: #2b2b2b;
    --iw-ink: #f2f2f2;
    --iw-ink-soft: #a5a5a5;
    --iw-rule: #f2f2f2;
    --iw-faint: #4a4a4a;
  }

  .iw-sheet *,
  .iw-sheet *::before,
  .iw-sheet *::after {
    box-sizing: border-box;
  }

  /* ---- 글자 ---- */

  .iw-tag {
    display: block;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .iw-tag em,
  .iw-rule-title em,
  .iw-debility-title em,
  .iw-status-title em,
  .iw-side-word em {
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--iw-ink-soft);
  }

  .iw-hint {
    margin: 0.3rem 0 0;
    font-size: 0.6rem;
    line-height: 1.45;
    color: var(--iw-ink-soft);
  }

  .iw-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---- 머리말 ---- */

  .iw-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem 1rem;
    align-items: end;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--iw-rule);
  }

  @media (min-width: 640px) {
    .iw-head {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
    }
  }

  .iw-experience {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .iw-bubbles {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  .iw-bubble-row {
    display: flex;
    gap: 0.22rem;
  }

  /* ---- 본문 3단 ---- */

  .iw-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.7rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .iw-body {
      grid-template-columns: 3.6rem minmax(0, 1fr) 8.5rem;
    }
  }

  .iw-center {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
  }

  /* ---- 모멘텀·상태 사다리 ---- */

  .iw-ladder {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--iw-rule);
  }

  .iw-ladder > li + li {
    border-top: 1px solid var(--iw-rule-soft);
  }

  .iw-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    cursor: pointer;
    position: relative;
  }

  .iw-cell-value {
    display: block;
    width: 100%;
    padding: 0.05rem 0.2rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* 켜진 칸은 검게 칠해 지금 값이 한눈에 보이게 한다. */
  .iw-cell:has(input:checked) .iw-cell-value {
    background: var(--iw-ink);
    color: var(--iw-paper);
  }

  .iw-cell:hover .iw-cell-value {
    background: var(--iw-paper-soft);
  }

  .iw-cell:has(input:checked):hover .iw-cell-value {
    background: var(--iw-ink);
  }

  .iw-cell:has(input:focus-visible) {
    outline: 2px solid var(--iw-rule);
    outline-offset: -2px;
  }

  .iw-ladder-foot {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.45rem;
  }

  .iw-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    border: 2px solid var(--iw-rule);
    padding: 0.15rem 0.1rem;
  }

  .iw-foot span {
    font-size: 0.52rem;
    letter-spacing: 0.06em;
    text-align: center;
  }

  .iw-status {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .iw-status-title {
    margin: 0;
    padding: 0.16rem 0.3rem;
    background: var(--iw-ink);
    color: var(--iw-paper);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .iw-status-title em {
    color: color-mix(in oklab, var(--iw-paper) 70%, transparent);
  }

  .iw-ladder--status > li + li {
    border-top: 1px solid var(--iw-rule-soft);
  }

  .iw-ladder--status .iw-cell-value {
    font-size: 0.78rem;
  }

  /* ---- 입력 ---- */

  .iw-input {
    width: 100%;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--iw-ink);
    font: inherit;
    font-size: 0.8rem;
    padding: 0.05rem 0.1rem;
    /* 숫자 칸에도 증감 화살표를 두지 않는다. */
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .iw-input::placeholder {
    color: var(--iw-ink-soft);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  .iw-input--name {
    border-bottom: 2px solid var(--iw-rule);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .iw-input--number {
    width: 2.4rem;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .iw-input::-webkit-outer-spin-button,
  .iw-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .iw-input:focus-visible {
    outline: 2px solid var(--iw-rule);
    outline-offset: 1px;
    border-radius: 2px;
  }

  .iw-tick {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    flex: none;
    width: 0.82rem;
    height: 0.82rem;
    margin: 0;
    border: 1.5px solid var(--iw-rule);
    border-radius: 0;
    background: transparent;
    cursor: pointer;
  }

  .iw-tick--round {
    border-radius: 50%;
  }

  .iw-tick:checked {
    background: var(--iw-ink);
  }

  .iw-tick:focus-visible {
    outline: 2px solid var(--iw-rule);
    outline-offset: 1px;
  }

  /* ---- 능력치 ---- */

  .iw-stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .iw-stat {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    flex-wrap: wrap;
    min-height: 2.6rem;
    padding: 0.15rem;
    border: 3px solid var(--iw-rule);
  }

  .iw-stat-value {
    width: 1.7rem;
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
  }

  .iw-stat-name {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .iw-stat-name-en {
    width: 100%;
    text-align: center;
    font-size: 0.48rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--iw-ink-soft);
  }

  /* ---- 가운데 띠 제목 ---- */

  .iw-block {
    display: flex;
    flex-direction: column;
  }

  /* 가운데에 이름이 끼어 있는 가는 가로줄. */
  .iw-rule-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.2rem 0 0.45rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .iw-rule-title::before,
  .iw-rule-title::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: var(--iw-rule);
  }

  /* ---- 유대 ---- */

  .iw-bonds {
    display: flex;
    justify-content: center;
    gap: 0.28rem;
    flex-wrap: wrap;
  }

  .iw-bonds .iw-tick {
    width: 1rem;
    height: 1rem;
  }

  /* ---- 맹세 ---- */

  .iw-vows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .iw-vow {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .iw-vow-name {
    display: block;
    padding: 0.1rem 0.3rem;
    background: var(--iw-paper-soft);
  }

  .iw-ranks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    justify-content: center;
  }

  .iw-rank {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .iw-rank .iw-tick {
    width: 0.68rem;
    height: 0.68rem;
  }

  .iw-progress {
    display: flex;
    justify-content: center;
    gap: 0.22rem;
  }

  .iw-progress .iw-tick {
    /* 진행 트랙은 별 하나가 틱 넷이라 조금 넉넉하게 둔다. */
    width: 1rem;
    height: 1rem;
  }

  /* ---- 결점 ---- */

  .iw-debilities {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem 1rem;
  }

  @media (min-width: 560px) {
    .iw-debilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .iw-debility-group ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.2rem 0.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .iw-debility-title {
    margin: 0 0 0.25rem;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .iw-debility {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  /* ---- 아래 띠 ---- */

  .iw-wordmark {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.3rem;
    min-height: 5.6rem;
    padding: 1.6rem 0.6rem 0.6rem;
    background: var(--iw-ink);
    color: var(--iw-paper);
    overflow: hidden;
  }

  .iw-ridge {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0.85rem;
  }

  .iw-ridge path {
    fill: var(--iw-rule-soft);
  }

  .iw-wordmark-text {
    flex: 1;
    text-align: center;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.2em;
  }

