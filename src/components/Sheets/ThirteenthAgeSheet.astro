<script>
  import { modifierLabel } from '../../utils/thirteenthAge';

  // 시트에 적은 값과 표시를 브라우저에 남겨 둔다.
  //
  // 열쇠를 요소 순서로 만들면 시트 모양을 고칠 때마다 저장해 둔 값이 엉뚱한 칸으로
  // 옮겨 간다. 그래서 '쪽 + 칸 이름 + 꼬리표'로 열쇠를 만든다.
  const STORAGE_PREFIX = 'ta-sheet:v2:';

  type SheetControl = HTMLInputElement | HTMLTextAreaElement;

  function isToggle(control: SheetControl): control is HTMLInputElement {
    return (
      control instanceof HTMLInputElement &&
      (control.type === 'checkbox' || control.type === 'radio')
    );
  }

  /** 컨트롤마다 안정적인 열쇠를 만든다. 꼬리표가 겹치면 같은 칸 안에서 번호를 붙인다. */
  function keysFor(sheet: HTMLElement): string[] {
    const pages = Array.from(sheet.querySelectorAll('.ta-page'));
    const seen = new Map<string, number>();

    return Array.from(sheet.querySelectorAll<SheetControl>('input, textarea')).map((control) => {
      const page = control.closest('.ta-page');
      const section = control.closest('.ta-card')?.querySelector('.ta-ribbon')?.firstChild?.textContent?.trim() ?? '';
      const label =
        control.getAttribute('aria-label') ?? control.getAttribute('name') ?? control.type;
      const base = `p${page ? pages.indexOf(page) + 1 : 0}|${section}|${label}`;
      const count = (seen.get(base) ?? 0) + 1;
      seen.set(base, count);
      return count === 1 ? base : `${base}#${count}`;
    });
  }

  function restore(sheet: HTMLElement) {
    const slug = sheet.dataset.taSheet;
    if (!slug) return;

    const storageKey = STORAGE_PREFIX + slug;
    const controls = Array.from(sheet.querySelectorAll<SheetControl>('input, textarea'));
    const keys = keysFor(sheet);

    let saved: Record<string, string | boolean> = {};
    try {
      saved = JSON.parse(localStorage.getItem(storageKey) ?? '{}') as Record<
        string,
        string | boolean
      >;
    } catch {
      saved = {};
    }

    controls.forEach((control, index) => {
      const value = saved[keys[index]];
      if (value === undefined) return;
      if (isToggle(control)) {
        if (value === true) control.checked = true;
      } else {
        control.value = String(value);
      }
    });

    const save = () => {
      const next: Record<string, string | boolean> = {};
      controls.forEach((control, index) => {
        next[keys[index]] = isToggle(control) ? control.checked : control.value;
      });
      try {
        localStorage.setItem(storageKey, JSON.stringify(next));
      } catch {
        /* 저장할 수 없는 환경(사생활 보호 모드 등)에서는 조용히 넘어간다. */
      }
    };

    sheet.addEventListener('input', save);
    sheet.addEventListener('change', save);
  }

  /** 능력치 점수를 고치면 수정치를 규칙대로 다시 계산해 보여 준다. */
  function wireAbilityScores(sheet: HTMLElement) {
    sheet.querySelectorAll<HTMLInputElement>('.ta-ability-score').forEach((input) => {
      const sync = () => {
        const output = input.closest('.ta-ability-plate')?.querySelector('.ta-ability-mod');
        if (output) output.textContent = modifierLabel(input.value);
      };

      // 저장해 둔 점수를 되살린 뒤에도 수정치가 점수와 맞도록 한 번 맞춰 둔다.
      sync();
      input.addEventListener('input', sync);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-ta-sheet]').forEach((sheet) => {
    restore(sheet);
    wireAbilityScores(sheet);
  });
</script>

