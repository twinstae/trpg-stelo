---
import type { ThirteenthAgeCharacter, TaPower } from './thirteenthAgeCharacter';
import { abilityModifier, signed } from '../../utils/thirteenthAge';

interface Props {
  character: Readonly<ThirteenthAgeCharacter>;
}

const { character } = Astro.props;

/** 시트에 인쇄된 행동 표시를 한국어로 옮긴다. */
const ACTION_KO: Record<string, string> = {
  Free: '자유',
  Std: '표준',
  Move: '이동',
  Int: '교전',
  Quick: '빠른',
  '—': '—',
};

const actionKo = (action: string) => ACTION_KO[action] ?? action;

/** 사용 상자에 실리는 줄만 골라낸다. */
function usageRows(list: TaPower[]): TaPower[] {
  return list.filter(
    (power) => power.usage && (power.usage.atWill || power.usage.perBattle || power.usage.perArc),
  );
}

const frontUsage = usageRows(character.powers);
const backUsage = usageRows(character.morePowers);
---

<div class="ta-sheet" data-ta-sheet={character.slug}>
  <!-- ───────────── 앞면 ───────────── -->
  <article class="ta-page" aria-label={`${character.className} ${character.buildName} 캐릭터 시트 앞면`}>
    <header class="ta-masthead">
      <div class="ta-identity">
        <label class="ta-field">
          <span class="ta-field-label">이름 <em>Name</em></span>
          <input
            type="text"
            class="ta-input ta-input--name"
            value={character.name}
            aria-label="이름"
          />
        </label>
        <div class="ta-kin">
          <span class="ta-field-label">종족 <em>Kin</em></span>
          <span class="ta-kin-value">
            {character.kin} <em>{character.kinEn}</em>
          </span>
        </div>
      </div>

      <div class="ta-class">
        <p class="ta-build">
          {character.buildName} <em>{character.buildNameEn}</em> 빌드
        </p>
        <h2 class="ta-class-title">
          {character.className} <span>{character.classNameEn}</span>
        </h2>
      </div>

      <label class="ta-field ta-field--level">
        <span class="ta-field-label">레벨 <em>Level</em></span>
        <input
          type="number"
          class="ta-input ta-input--level"
          min="1"
          max="10"
          value={character.level}
          aria-label="레벨"
        />
      </label>
    </header>

    <label class="ta-field ta-field--wide">
      <span class="ta-field-label">설명 <em>Description</em></span>
      <input type="text" class="ta-input" value={character.description} aria-label="설명" />
    </label>

    <div class="ta-columns">
      <!-- 왼쪽 열 -->
      <div class="ta-col">
        <section class="ta-card">
          <h3 class="ta-ribbon">한가지 특별한 것 <span>One Unique Thing</span></h3>
          <textarea class="ta-textarea ta-textarea--tall" aria-label="한가지 특별한 것"
            >{character.oneUniqueThing}</textarea
          >
        </section>

        <section class="ta-card">
          <h3 class="ta-ribbon">분노와 해골 <span>Rage &amp; Skulls</span></h3>
          <div class="ta-rage">
            <label class="ta-token">
              <input
                type="checkbox"
                class="ta-tick ta-tick--round ta-tick--lg ta-token-mark"
                aria-label="격노 표시"
              />
              <span class="ta-token-label">격노</span>
            </label>
            <ul class="ta-rage-rules">
              {character.rage.rules.map((rule) => <li>{rule}</li>)}
            </ul>
          </div>
          <p class="ta-rage-ends">{character.rage.ends}</p>

          <ul class="ta-skulls">
            {
              Array.from({ length: character.rage.skulls }).map((_, index) => (
                <>
                  <li class="ta-skull">
                    <input
                      type="checkbox"
                      class="ta-tick ta-tick--skull"
                      aria-label={`해골 ${index + 1}`}
                    />
                  </li>
                  {character.rage.skullMarks[index] && (
                    <li class="ta-skull-mark">{character.rage.skullMarks[index]}</li>
                  )}
                </>
              ))
            }
          </ul>
          <p class="ta-hint">{character.rage.determination}</p>
        </section>

        <section class="ta-card">
          <h3 class="ta-ribbon">출신 <span>Backgrounds</span></h3>
          <div class="ta-backgrounds-head">
            <span>출신</span>
            <span>보너스</span>
          </div>
          <ul class="ta-backgrounds">
            {
              Array.from({ length: character.backgroundRows }).map((_, index) => (
                <li class="ta-background">
                  <input
                    type="text"
                    class="ta-input"
                    value={character.backgrounds[index]?.title ?? ''}
                    aria-label={`출신 ${index + 1}`}
                  />
                  <input
                    type="number"
                    class="ta-input ta-input--bonus"
                    value={character.backgrounds[index]?.bonus ?? ''}
                    aria-label={`출신 ${index + 1} 보너스`}
                  />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="ta-card">
          <h3 class="ta-ribbon">기능 판정 <span>Skill Check</span></h3>
          <p class="ta-skillcheck">
            <span class="ta-skillcheck-value">{character.level}</span>
            <span class="ta-skillcheck-label">레벨</span>
            <span class="ta-skillcheck-plus">+</span>
            <span class="ta-skillcheck-label">능력 수정치</span>
            <span class="ta-skillcheck-plus">+</span>
            <span class="ta-skillcheck-label">출신</span>
          </p>
          <p class="ta-hint">{character.skillCheckNote}</p>
          <p class="ta-note-line">{character.prowessNote}</p>
        </section>

        <section class="ta-card ta-card--grow">
          <h3 class="ta-ribbon">표상 관계 <span>Icon Relationships</span></h3>
          <div class="ta-icons-head">
            <span>d6</span>
            <span>+/±/−</span>
            <span>표상</span>
            <span>사용</span>
          </div>
          <ul class="ta-icons">
            {
              Array.from({ length: character.iconRows }).map((_, row) => (
                <li class="ta-icon-row">
                  <input type="number" class="ta-input ta-input--d6" aria-label="d6" />
                  <span class="ta-icon-signs">
                    {['+', '±', '−'].map((sign) => (
                      <label class="ta-sign">
                        <input
                          type="radio"
                          class="ta-tick ta-tick--round"
                          name={`ta-icon-${character.slug}-${row}`}
                          aria-label={sign}
                        />
                        <span>{sign}</span>
                      </label>
                    ))}
                  </span>
                  <input type="text" class="ta-input" aria-label={`표상 ${row + 1}`} />
                  <span class="ta-icon-marks">
                    {Array.from({ length: character.iconMarks }).map(() => (
                      <input type="checkbox" class="ta-tick" aria-label="사용" />
                    ))}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="ta-hint">+ 우호적, ± 갈등, − 적대적 관계.</p>
        </section>
      </div>

      <!-- 가운데 열 -->
      <div class="ta-col">
        <section class="ta-card">
          <h3 class="ta-ribbon">능력치 <span>Ability Scores</span></h3>
          <p class="ta-rule-label">
            <span>장갑 <em>Armor Class</em></span>
          </p>
          <ul class="ta-abilities">
            {
              character.abilities.map((ability) => (
                <li class="ta-ability">
                  <span class="ta-ability-plate">
                    <span class="ta-ability-box">
                      <span class="ta-ability-tag">점수</span>
                      <input
                        type="number"
                        class="ta-input ta-ability-score"
                        value={ability.score}
                        aria-label={`${ability.label} 점수`}
                      />
                    </span>
                    <span class="ta-ability-circle">
                      <span class="ta-ability-mod" title="점수에서 계산되는 값입니다">
                        {signed(abilityModifier(ability.score))}
                      </span>
                      <span class="ta-ability-mod-label">수정치</span>
                    </span>
                  </span>
                  <span class="ta-ability-name">{ability.label}</span>
                  <span class="ta-ability-name-en">{ability.labelEn}</span>
                </li>
              ))
            }
          </ul>
          <div class="ta-defense-groups">
            <span class="ta-defense-group">신방 <em>Physical Defense</em></span>
            <span class="ta-defense-group">정방 <em>Mental Defense</em></span>
          </div>
        </section>

        <section class="ta-card">
          <h3 class="ta-ribbon">방어와 행동 순서 <span>Defenses &amp; Initiative</span></h3>
          <div class="ta-defenses">
            <label class="ta-defense">
              <input
                type="number"
                class="ta-input ta-input--big"
                value={character.defenses.armorClass}
                aria-label="장갑"
              />
              <span class="ta-defense-name">장갑 <em>Armor Class</em></span>
            </label>
            <label class="ta-defense">
              <input
                type="number"
                class="ta-input ta-input--big"
                value={character.defenses.physical}
                aria-label="신방"
              />
              <span class="ta-defense-name">신방 <em>Physical</em></span>
            </label>
            <label class="ta-defense">
              <input
                type="number"
                class="ta-input ta-input--big"
                value={character.defenses.mental}
                aria-label="정방"
              />
              <span class="ta-defense-name">정방 <em>Mental</em></span>
            </label>
            <label class="ta-defense">
              <input
                type="number"
                class="ta-input ta-input--big"
                value={character.defenses.initiative}
                aria-label="행동 순서"
              />
              <span class="ta-defense-name">행동 순서 <em>Initiative</em></span>
            </label>
          </div>
          <ul class="ta-derivation">
            {character.defenses.derivation.map((line) => <li>{line}</li>)}
          </ul>
        </section>

        <section class="ta-card">
          <h3 class="ta-ribbon">격노 공격 <span>Raging Strike &amp; Throw</span></h3>
          <div class="ta-raging">
            <div class="ta-raging-box">
              <span class="ta-raging-value">{character.ragingAttack.crit}</span>
              <span class="ta-raging-label">치명타</span>
            </div>
            <div class="ta-raging-box">
              <span class="ta-raging-value">{character.ragingAttack.miss}</span>
              <span class="ta-raging-label">빗나감</span>
            </div>
          </div>
          <p class="ta-hint">{character.ragingAttack.note}</p>
        </section>

        {
          [character.meleeAttack, character.rangedAttack].map((attack) => (
            <section class="ta-card">
              <h3 class="ta-ribbon">
                {attack === character.meleeAttack ? '기본 근접 공격' : '기본 원거리 공격'}
                <span>{attack === character.meleeAttack ? 'Basic Melee Attack' : 'Basic Ranged Attack'}</span>
              </h3>
              <div class="ta-attack">
                <div class="ta-attack-name">
                  <strong>{attack.title}</strong>
                  {attack.titleEn && <em>{attack.titleEn}</em>}
                  <span class="ta-attack-kind">{attack.kind}</span>
                </div>
                <div class="ta-attack-stats">
                  <span class="ta-attack-cell">
                    <span class="ta-attack-value">{attack.damage}</span>
                    <span class="ta-attack-label">피해</span>
                  </span>
                  <span class="ta-attack-cell">
                    <span class="ta-attack-value">{attack.average}</span>
                    <span class="ta-attack-label">평균</span>
                  </span>
                  <span class="ta-attack-cell">
                    <span class="ta-attack-value">{attack.miss}</span>
                    <span class="ta-attack-label">빗나감</span>
                  </span>
                  <span class="ta-attack-cell ta-attack-cell--attack">
                    <span class="ta-attack-value">{signed(attack.attack)}</span>
                    <span class="ta-attack-label">{attack.target}</span>
                  </span>
                </div>
              </div>
            </section>
          ))
        }

        <section class="ta-card ta-card--grow">
          <h3 class="ta-ribbon">특징 · 재능 · 능력 <span>Features, Talents &amp; Powers</span></h3>
          <table class="ta-powers">
            <thead>
              <tr>
                <th>행동</th>
                <th>이름</th>
                <th>발동 · 대상 · 효과</th>
                <th>쪽</th>
              </tr>
            </thead>
            <tbody>
              {
                character.powers.map((power) => (
                  <tr class:list={[{ 'ta-power--indent': power.indent }]}>
                    <td class="ta-power-action">
                      {power.indent ? '' : actionKo(power.action)}
                    </td>
                    <td class="ta-power-name">
                      {power.title}
                      {(power.tag || power.indent) && (
                        <span class="ta-power-parent">{power.tag ?? '야수 상'}</span>
                      )}
                    </td>
                    <td class="ta-power-effect">{power.effect}</td>
                    <td class="ta-power-page">{power.page ?? ''}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </section>
      </div>

      <!-- 오른쪽 열 -->
      <div class="ta-col">
        <section class="ta-card">
          <h3 class="ta-ribbon">체력과 원기 <span>Hit Points &amp; Recoveries</span></h3>
          <div class="ta-hp">
            <label class="ta-hp-main">
              <input
                type="number"
                class="ta-input ta-input--hp"
                value={character.hp.max}
                aria-label="최대 체력"
              />
              <span class="ta-hp-label">최대 체력 <em>Max HP</em></span>
            </label>
            <label class="ta-hp-side">
              <input
                type="number"
                class="ta-input"
                value={character.hp.staggered}
                aria-label="휘청"
              />
              <span>휘청 <em>Staggered</em></span>
            </label>
            <label class="ta-hp-side">
              <input
                type="number"
                class="ta-input"
                value={character.hp.dead}
                aria-label="죽음"
              />
              <span>죽음 <em>Dead</em></span>
            </label>
            <div class="ta-recoveries">
              <label>
                <input
                  type="number"
                  class="ta-input"
                  value={character.hp.maxRecoveries}
                  aria-label="최대 원기"
                />
                <span>최대 원기</span>
              </label>
              <ul class="ta-recovery-track">
                {
                  Array.from({ length: character.hp.maxRecoveries }).map(() => (
                    <li>
                      <input type="checkbox" class="ta-tick" aria-label="원기 사용" />
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <div class="ta-hp-extra">
            <label class="ta-field">
              <span class="ta-field-label">현재 체력 <em>Current HP</em></span>
              <input type="number" class="ta-input" aria-label="현재 체력" />
            </label>
            <label class="ta-field">
              <span class="ta-field-label">임시 체력 <em>Temp HP</em></span>
              <input type="number" class="ta-input" aria-label="임시 체력" />
            </label>
            <label class="ta-field">
              <span class="ta-field-label">회복 주사위 <em>Recovery Dice</em></span>
              <span class="ta-recovery-dice">{character.hp.recoveryDice}</span>
            </label>
            <label class="ta-field">
              <span class="ta-field-label">회복량 평균 <em>Average</em></span>
              <span class="ta-recovery-average">{character.hp.recoveryAverage}</span>
            </label>
          </div>

          <div class="ta-ongoing">
            <span class="ta-field-label">지속 피해 <em>Ongoing</em></span>
            <input type="text" class="ta-input" aria-label="지속 피해" />
            <span class="ta-field-label">종류 <em>Type</em></span>
            <input type="text" class="ta-input" aria-label="종류" />
            <span class="ta-field-label">내성 <em>Save</em></span>
            <input type="checkbox" class="ta-tick" aria-label="지속 피해 내성" />
          </div>
        </section>

        <section class="ta-card">
          <h3 class="ta-ribbon">사용 <span>Usage</span></h3>
          <div class="ta-usage-head">
            <span />
            <span>상시·재충전</span>
            <span>전투당</span>
            <span>장당</span>
          </div>
          <ul class="ta-usage">
            {
              frontUsage.map((power) => (
                <li class:list={['ta-usage-row', { 'ta-usage-row--indent': power.indent }]}>
                  <span class="ta-usage-name">{power.title}</span>
                  <span class="ta-usage-cell">
                    {power.usage?.atWill && (
                      <input
                        type="checkbox"
                        class="ta-tick"
                        aria-label={`${power.title} 상시·재충전`}
                      />
                    )}
                  </span>
                  <span class="ta-usage-cell">
                    {power.usage?.perBattle && (
                      <input
                        type="checkbox"
                        class="ta-tick"
                        aria-label={`${power.title} 전투당`}
                      />
                    )}
                  </span>
                  <span class="ta-usage-cell">
                    {power.usage?.perArc && (
                      <input
                        type="checkbox"
                        class="ta-tick"
                        aria-label={`${power.title} 장당`}
                      />
                    )}
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="ta-card ta-card--grow">
          <h3 class="ta-ribbon">조건 및 기타 효과 <span>Conditions &amp; Other Effects</span></h3>
          <div class="ta-conditions-head">
            <span>조건</span>
            <span>내성</span>
          </div>
          <ul class="ta-conditions">
            {
              Array.from({ length: 6 }).map(() => (
                <li class="ta-condition">
                  <input type="text" class="ta-input" aria-label="조건" />
                  <input type="checkbox" class="ta-tick" aria-label="내성" />
                </li>
              ))
            }
          </ul>
          <p class="ta-turnline">
            당신의 턴: 표준 행동 하나 · 이동 행동 하나 · 빠른 행동 하나, 그리고 자유 행동은 원하는
            만큼. 턴 사이에 교전 행동 하나.
          </p>
        </section>
      </div>
    </div>
  </article>

  <!-- ───────────── 뒷면 ───────────── -->
  <article class="ta-page" aria-label={`${character.className} ${character.buildName} 캐릭터 시트 뒷면`}>
    <div class="ta-columns">
      <!-- 왼쪽 열 -->
      <div class="ta-col">
        <section class="ta-card">
          <h3 class="ta-ribbon">마법 물품 <span>Magic Items</span></h3>
          <div class="ta-attunement">
            <input
              type="number"
              class="ta-input ta-input--hp"
              value={character.magicItemAttunement}
              aria-label="최대 각성"
            />
            <span>최대 각성 <em>Max Attuned</em></span>
          </div>
          <ul class="ta-lines">
            {Array.from({ length: 5 }).map(() => (
              <li>
                <input type="text" class="ta-input" aria-label="마법 물품" />
              </li>
            ))}
          </ul>
        </section>

        <section class="ta-card">
          <h3 class="ta-ribbon">물약과 룬 <span>Potions &amp; Runes</span></h3>
          <ul class="ta-potions">
            {
              character.potions.map((potion) => (
                <li class="ta-potion">
                  <input type="checkbox" class="ta-tick" aria-label={potion.title} />
                  <span>
                    <strong>{potion.title}</strong>: {potion.effect}
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="ta-card ta-card--grow">
          <h3 class="ta-ribbon">기타 특징 <span>Miscellaneous Features</span></h3>
          <ul class="ta-misc">
            {character.miscFeatures.map((feature) => <li>{feature}</li>)}
          </ul>
        </section>
      </div>

      <!-- 가운데 열 -->
      <div class="ta-col">
        <section class="ta-card">
          <h3 class="ta-ribbon">더 많은 특징 · 재능 · 능력 <span>More Features, Talents &amp; Powers</span></h3>
          <table class="ta-powers">
            <thead>
              <tr>
                <th>행동</th>
                <th>이름</th>
                <th>발동 · 대상 · 효과</th>
                <th>쪽</th>
              </tr>
            </thead>
            <tbody>
              {
                character.morePowers.map((power) => (
                  <tr>
                    <td class="ta-power-action">{actionKo(power.action)}</td>
                    <td class="ta-power-name">
                      {power.title}
                      {power.tag && <span class="ta-power-parent">{power.tag}</span>}
                    </td>
                    <td class="ta-power-effect">{power.effect}</td>
                    <td class="ta-power-page">{power.page ?? ''}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="ta-turnline">
            당신의 턴: 표준 행동 하나 · 이동 행동 하나 · 빠른 행동 하나, 그리고 자유 행동은 원하는
            만큼. 턴 사이에 교전 행동 하나.
          </p>
        </section>

        <section class="ta-card ta-card--grow">
          <h3 class="ta-ribbon">장비와 기록 <span>Gear &amp; Notes</span></h3>
          <div class="ta-gear">
            <label class="ta-gear-cell">
              <input
                type="number"
                class="ta-input ta-input--big"
                value={character.gear.armorBonus}
                aria-label="갑옷 기본 장갑"
              />
              <span>갑옷</span>
            </label>
            <span class="ta-gear-plus">+</span>
            <label class="ta-gear-cell">
              <input
                type="number"
                class="ta-input ta-input--big"
                value={character.gear.shieldBonus}
                aria-label="방패"
              />
              <span>방패</span>
            </label>
            <span class="ta-gear-plus">=</span>
            <label class="ta-gear-cell">
              <input
