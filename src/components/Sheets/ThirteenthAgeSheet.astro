    margin: 0;
  }

  .ta-skull-mark {
    flex: 1;
    text-align: center;
    font-size: 0.46rem;
    letter-spacing: 0.02em;
    color: var(--ta-ink-soft);
    border-bottom: 1px solid var(--ta-rule-soft);
    padding-bottom: 0.05rem;
    white-space: nowrap;
  }

  /* ---- 출신 ---- */

  .ta-backgrounds-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3rem;
    gap: 0.4rem;
    font-size: 0.48rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ta-rule);
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--ta-rule);
  }

  .ta-backgrounds-head span:last-child {
    text-align: center;
  }

  .ta-backgrounds {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin: 0.4rem 0 0;
  }

  .ta-background {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3rem;
    gap: 0.4rem;
  }

  .ta-input--bonus {
    text-align: center;
  }

  .ta-derivation {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.58rem;
    line-height: 1.4;
    color: var(--ta-ink-soft);
  }

  .ta-derivation li {
    position: relative;
    padding-left: 0.7rem;
  }

  .ta-derivation li::before {
    content: '=';
    position: absolute;
    left: 0;
    color: var(--ta-rule-soft);
  }

  /* ---- 기술 판정 ---- */

  .ta-skillcheck {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin: 0;
  }

  .ta-skillcheck-value {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 2px solid var(--ta-rule);
    border-radius: 50%;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ta-rule);
  }

  .ta-skillcheck-label {
    font-size: 0.58rem;
    color: var(--ta-ink-soft);
  }

  .ta-skillcheck-plus {
    font-weight: 700;
    color: var(--ta-rule);
  }

  /* ---- 표상 관계 ---- */

  .ta-icons-head {
    display: grid;
    grid-template-columns: 3rem minmax(0, 4.6rem) minmax(0, 1fr) minmax(0, 4.4rem);
    gap: 0.3rem;
    font-size: 0.52rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ta-rule);
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--ta-rule-soft);
  }

  .ta-icons {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .ta-icon-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 4.6rem) minmax(0, 1fr) minmax(0, 4.4rem);
    gap: 0.3rem;
    align-items: center;
    padding: 0.28rem 0;
    border-bottom: 1px dotted var(--ta-faint);
  }

  .ta-icon-row:last-child {
    border-bottom: none;
  }

  .ta-input--d6 {
    text-align: center;
  }

  .ta-icon-signs {
    display: inline-flex;
    justify-content: space-around;
  }

  .ta-sign {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.62rem;
    cursor: pointer;
  }

  .ta-icon-marks {
    display: inline-flex;
    gap: 0.16rem;
    justify-content: flex-end;
  }

  /* ---- 능력치 ---- */

  /* 가운데에 라벨이 끼어 있는 가는 가로줄. */
  .ta-rule-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.55rem;
  }

  .ta-rule-label::before,
  .ta-rule-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--ta-rule-soft);
  }

  .ta-rule-label span {
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ta-ink-soft);
    white-space: nowrap;
  }

  .ta-rule-label em {
    font-style: normal;
    color: var(--ta-rule);
  }

  .ta-abilities {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ta-ability {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    min-width: 0;
  }

  /* 점수 네모 상자 뒤로 수정치 동그라미가 겹쳐 나오는 모양. */
  .ta-ability-plate {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.08;
    margin: 0.25rem 0 0.25rem;
  }

  .ta-ability-box {
    position: absolute;
    top: 0;
    left: 0;
    right: 24%;
    bottom: 30%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 동그라미가 덮는 오른쪽 아래를 비켜 숫자를 놓는다. */
    padding: 0 0.6rem 0.6rem 0;
    border: 2px solid var(--ta-rule);
    border-radius: 2px;
  }

  .ta-ability-tag {
    position: absolute;
    top: -0.35rem;
    left: 0.1rem;
    padding: 0 0.12rem;
    background: var(--ta-paper);
    font-size: 0.4rem;
    letter-spacing: 0.06em;
    color: var(--ta-ink-soft);
  }

  .ta-ability-score {
    width: 100%;
    padding: 0;
    border-bottom: none;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    text-align: center;
  }

  .ta-ability-circle {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 66%;
    aspect-ratio: 1;
    border: 2px solid var(--ta-rule);
    border-radius: 50%;
    background: var(--ta-paper);
  }

  .ta-ability-mod {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    color: var(--ta-rule);
  }

  .ta-ability-mod-label {
    font-size: 0.38rem;
    letter-spacing: 0.08em;
    color: var(--ta-ink-soft);
  }

  .ta-ability-name {
    font-family: var(--font-serif);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ta-rule);
    white-space: nowrap;
  }

  .ta-ability-name-en {
    font-size: 0.4rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ta-ink-soft);
    white-space: nowrap;
  }

  /* 앞의 세 능력치 밑에 신방, 뒤의 세 능력치 밑에 정방. */
  .ta-defense-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .ta-defense-group {
    position: relative;
    padding-top: 0.3rem;
    text-align: center;
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ta-rule);
  }

  .ta-defense-group::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--ta-rule-soft);
  }

  .ta-defense-group em {
    font-style: normal;
    letter-spacing: 0.08em;
    color: var(--ta-ink-soft);
  }

  /* ---- 방어와 행동 순서 ---- */

  .ta-defenses {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .ta-defense {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .ta-input--big {
    text-align: center;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .ta-defense .ta-input--big {
    width: 100%;
    border: 2px solid var(--ta-rule);
    border-radius: 6px;
    padding: 0.1rem 0;
  }

  .ta-defense-name {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--ta-rule);
  }

  .ta-defense-name em {
    display: block;
    font-style: normal;
    font-size: 0.45rem;
    font-weight: 400;
    color: var(--ta-ink-soft);
  }

  /* ---- 격노 공격 ---- */

  .ta-raging {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .ta-raging-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.3rem 0.2rem;
    border: 1.5px dashed var(--ta-rule);
    border-radius: 6px;
  }

  .ta-raging-value {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--ta-rule);
    line-height: 1;
  }

  .ta-raging-label {
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ta-ink-soft);
  }

  /* ---- 기본 공격 ---- */

  .ta-attack-name {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
  }

  .ta-attack-name em {
    font-style: normal;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ta-ink-soft);
  }

  .ta-attack-kind {
    font-size: 0.58rem;
    color: var(--ta-ink-soft);
  }

  .ta-attack-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.3rem;
    margin-top: 0.4rem;
  }

  .ta-attack-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05rem;
    padding: 0.25rem 0.1rem;
    border: 1px solid var(--ta-rule-soft);
    border-radius: 6px;
  }

  .ta-attack-cell--attack {
    border: 2px solid var(--ta-rule);
  }

  .ta-attack-value {
    font-size: 0.95rem;
    font-weight: 800;
  }

  .ta-attack-label {
    font-size: 0.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ta-ink-soft);
  }

  /* ---- 능력 표 ---- */

  .ta-powers {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.66rem;
    line-height: 1.35;
  }

  .ta-powers th {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ta-rule);
    padding: 0 0.25rem 0.2rem;
    border-bottom: 1px solid var(--ta-rule);
  }

  .ta-powers td {
    padding: 0.28rem 0.25rem;
    border-bottom: 1px dotted var(--ta-faint);
    vertical-align: top;
  }

  .ta-powers tr:last-child td {
    border-bottom: none;
  }

  .ta-powers th:first-child,
  .ta-powers td:first-child {
    width: 2.6rem;
  }

  .ta-powers th:last-child,
  .ta-powers td:last-child {
    width: 2.4rem;
    text-align: right;
  }

  .ta-power-action {
    font-weight: 700;
    color: var(--ta-rule);
    white-space: nowrap;
  }

  .ta-power-name {
    font-weight: 700;
  }

  .ta-power--indent .ta-power-name {
    font-weight: 400;
    padding-left: 0.5rem;
  }

  .ta-power--indent .ta-power-effect {
    padding-left: 0.5rem;
  }

  .ta-power-parent {
    display: block;
    font-size: 0.5rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--ta-ink-soft);
  }

  .ta-power-page {
    color: var(--ta-ink-soft);
    white-space: nowrap;
  }

  /* ---- 체력과 원기 ---- */

  .ta-hp {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem;
    align-items: center;
  }

  .ta-hp-main,
  .ta-hp-side,
  .ta-recoveries {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
  }

  .ta-hp-side span,
  .ta-recoveries span {
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--ta-ink-soft);
  }

  .ta-hp-side em,
  .ta-recoveries em {
    display: block;
    font-style: normal;
  }

  .ta-hp-label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-align: center;
    color: var(--ta-rule);
  }

  .ta-hp-label em {
    display: block;
    font-style: normal;
    font-weight: 400;
    color: var(--ta-ink-soft);
  }

  .ta-input--hp {
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 700;
    border-bottom: none;
  }

  .ta-hp-main,
  .ta-hp-side {
    padding: 0.25rem 0.1rem;
    border: 2px solid var(--ta-rule);
    border-radius: 50% 50% 6px 6px / 40% 40% 6px 6px;
  }

  .ta-hp-side {
    border-radius: 6px;
  }

  .ta-hp-side .ta-input {
    text-align: center;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .ta-recoveries {
    gap: 0.2rem;
  }

  .ta-recoveries .ta-input {
    text-align: center;
    font-size: 0.95rem;
    font-weight: 800;
    border: 1.5px solid var(--ta-rule);
    border-radius: 6px;
  }

  .ta-recovery-track {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.16rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ta-hp-extra {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .ta-recovery-dice,
  .ta-recovery-average {
    font-size: 0.8rem;
    font-weight: 700;
  }

  .ta-recovery-average {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 2px solid var(--ta-rule);
    border-radius: 50%;
    color: var(--ta-rule);
  }

  .ta-ongoing {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto minmax(0, 1fr) auto auto;
    gap: 0.3rem;
    align-items: center;
    margin-top: 0.6rem;
    padding-top: 0.4rem;
    border-top: 1px dotted var(--ta-faint);
  }

  /* ---- 사용 ---- */

  .ta-usage-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) repeat(3, 2.8rem);
    gap: 0.2rem;
    font-size: 0.48rem;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--ta-rule);
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--ta-rule);
  }

  .ta-usage-head span:first-child {
    text-align: left;
  }

  .ta-usage-head span:not(:first-child) {
    border-left: 1px solid var(--ta-rule-soft);
  }

  .ta-usage {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .ta-usage-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) repeat(3, 2.8rem);
    gap: 0.2rem;
    align-items: center;
    padding: 0.22rem 0;
    border-bottom: 1px dotted var(--ta-faint);
    font-size: 0.66rem;
  }

  .ta-usage-row:last-child {
    border-bottom: none;
  }

  .ta-usage-row--indent .ta-usage-name {
    padding-left: 0.6rem;
    font-size: 0.62rem;
  }

  .ta-usage-cell {
    display: inline-flex;
    justify-content: center;
    align-self: stretch;
    align-items: center;
    border-left: 1px dotted var(--ta-faint);
  }

  /* ---- 조건 ---- */

  .ta-conditions-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.4rem;
    gap: 0.3rem;
    font-size: 0.48rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ta-rule);
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--ta-rule);
  }

  .ta-conditions-head span:last-child {
    text-align: center;
  }

  .ta-conditions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .ta-condition {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.4rem;
    gap: 0.3rem;
    align-items: center;
    padding: 0.3rem 0;
    border-bottom: 1px dotted var(--ta-faint);
  }

  .ta-condition:last-child {
    border-bottom: none;
  }

  .ta-condition .ta-tick {
    justify-self: center;
  }

  /* ---- 마법 물품 / 물약 ---- */

  .ta-attunement {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .ta-attunement .ta-input--hp {
    width: 2.6rem;
    border: 2px solid var(--ta-rule);
    border-radius: 6px;
  }

  .ta-attunement span {
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ta-rule);
  }

  .ta-attunement em {
    display: block;
    font-style: normal;
    font-weight: 400;
    text-transform: none;
    color: var(--ta-ink-soft);
  }

  .ta-lines {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ta-potions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ta-potion {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .ta-potion .ta-tick {
    margin-top: 0.15rem;
  }

  .ta-misc {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .ta-misc li {
    position: relative;
    padding-left: 0.8rem;
  }

  .ta-misc li::before {
    content: '◆';
    position: absolute;
    left: 0;
    top: 0.3rem;
    font-size: 0.45rem;
    color: var(--ta-rule);
  }

  /* ---- 장비 ---- */

  .ta-gear {
    display: grid;
    grid-template-columns: auto auto auto auto auto minmax(0, 1fr);
    gap: 0.35rem;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .ta-gear-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.3rem 0.4rem;
    border: 2px solid var(--ta-rule);
    border-radius: 6px;
  }

  .ta-gear-cell span {
    font-size: 0.5rem;
    color: var(--ta-ink-soft);
    white-space: nowrap;
  }

  .ta-gear-cell .ta-input--big {
    width: 2.6rem;
  }

  .ta-gear-plus {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ta-rule);
  }

  .ta-gold {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .ta-gear-items {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.7rem;
  }

  .ta-gear-items span {
    color: var(--ta-ink-soft);
  }

  /* ---- 특기 ---- */

  .ta-feats-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5rem;
    gap: 0.3rem;
    font-size: 0.48rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ta-rule);
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--ta-rule);
  }

  .ta-feats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .ta-feat {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5rem;
    gap: 0.3rem;
    align-items: center;
    padding: 0.25rem 0;
    border-bottom: 1px dotted var(--ta-faint);
  }

