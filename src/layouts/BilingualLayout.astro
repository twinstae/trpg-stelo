---
import DocLayout from './DocLayout.astro';
import BilingualPageContent from '../components/PageContent/BilingualPageContent.astro';
import * as CONFIG from '../config';
import type { PairedBlock, ChapterHeading } from '../utils/pairChapterBlocks';

type NavChapter = { slug: string; titleKo: string };

type Props = {
	titleEn: string;
	titleKo: string;
	rows: PairedBlock[];
	headings: ChapterHeading[];
	prev: NavChapter | null;
	next: NavChapter | null;
	/** 이전/다음 장 링크의 기본 경로. 기본값은 사이퍼 SRD. */
	basePath?: string;
	/** 페이지 제목 뒤에 붙는 말머리. 기본값은 "[CSRD 2026]". */
	titleSuffix?: string;
	description?: string;
	/** 수정 링크가 가리킬 파일. 기본값은 사이퍼 SRD 한국어 원고. */
	editPath?: string;
	showTitle?: boolean;
	bilingual?: boolean;
	pendingNotice?: boolean;
	/** 번역 진행 상황 링크. 기본값은 던전월드 2 목차. */
	pendingNoticeHref?: string;
	/** 번역 진행 상황 링크의 이름. 기본값은 "던전월드 2 목차". */
	pendingNoticeLabel?: string;
	/** 안내문에서 가리킬 단위. 기본값은 "이 장". */
	pendingNoticeSubject?: string;
};

const {
	titleEn,
	titleKo,
	rows,
	headings,
	prev,
	next,
	basePath = '/ko/cypher-srd',
	titleSuffix = '[CSRD 2026]',
	description,
	editPath = `src/data/cypher-srd/ko/${Astro.params.slug}.md`,
	showTitle = false,
	bilingual = true,
	pendingNotice = false,
	pendingNoticeHref = '/ko/awe/dw2',
	pendingNoticeLabel = '던전월드 2 목차',
	pendingNoticeSubject = '이 장',
} = Astro.props as Props;

const frontmatter: CONFIG.Frontmatter = {
	title: `${titleKo} ${titleSuffix}`,
	description: description ?? `사이퍼 시스템 레퍼런스 문서(2026-07-29판) "${titleEn}" 챕터`,
	layout: '',
};

const githubEditUrl = `${CONFIG.GITHUB_EDIT_URL}/${editPath}`;

// astro:content style MarkdownHeading shape for the mobile/desktop TOC component
const tocHeadings = headings.map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));
---

<DocLayout frontmatter={frontmatter} headings={tocHeadings} githubEditUrl={githubEditUrl} pageTitle={titleKo} wide>
	<BilingualPageContent
		titleEn={titleEn}
		titleKo={titleKo}
		rows={rows}
		headings={tocHeadings}
		prev={prev}
		next={next}
		basePath={basePath}
		showTitle={showTitle}
		bilingual={bilingual}
		pendingNotice={pendingNotice}
		pendingNoticeHref={pendingNoticeHref}
		pendingNoticeLabel={pendingNoticeLabel}
		pendingNoticeSubject={pendingNoticeSubject}
	/>
</DocLayout>
