---
import HeadCommon from '../components/HeadCommon.astro';
import HeadSEO from '../components/HeadSEO.astro';
import Header from '../components/Header/Header.astro';
import BilingualPageContent from '../components/PageContent/BilingualPageContent.astro';
import LeftSidebar from '../components/LeftSidebar/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar/RightSidebar.astro';
import Footer from '../components/Footer/Footer.astro';
import ScrollTopButton from '../components/ScrollTopButton.astro';
import AddHeadingScript from '../components/AddHeadingScript.astro';
import * as CONFIG from '../config';
import type { PairedBlock, ChapterHeading } from '../utils/pairChapterBlocks';

type NavChapter = { slug: string; titleKo: string };

type Props = {
	titleEn: string;
	titleKo: string;
	rows: PairedBlock[];
	headings: ChapterHeading[];
	prev: NavChapter | null;
	next: NavChapter | null;
	/** 이전/다음 장 링크의 기본 경로. 기본값은 사이퍼 SRD. */
	basePath?: string;
	/** 페이지 제목 뒤에 붙는 말머리. 기본값은 "[CSRD 2026]". */
	titleSuffix?: string;
	description?: string;
	/** 수정 링크가 가리킬 파일. 기본값은 사이퍼 SRD 한국어 원고. */
	editPath?: string;
	showTitle?: boolean;
	bilingual?: boolean;
	pendingNotice?: boolean;
};

const {
	titleEn,
	titleKo,
	rows,
	headings,
	prev,
	next,
	basePath = '/ko/cypher-srd',
	titleSuffix = '[CSRD 2026]',
	description,
	editPath = `src/data/cypher-srd/ko/${Astro.params.slug}.md`,
	showTitle = false,
	bilingual = true,
	pendingNotice = false,
} = Astro.props as Props;

const frontmatter: CONFIG.Frontmatter = {
	title: `${titleKo} ${titleSuffix}`,
	description: description ?? `사이퍼 시스템 레퍼런스 문서(2026-07-29판) "${titleEn}" 챕터`,
	layout: '',
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPage = Astro.url.pathname;
const githubEditUrl = `${CONFIG.GITHUB_EDIT_URL}/${editPath}`;

// astro:content style MarkdownHeading shape for the mobile/desktop TOC component
const tocHeadings = headings.map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));
---

<html dir="ltr" lang="ko" class="initial" data-theme="bumblebee">
	<head>
		<HeadCommon />
		<HeadSEO frontmatter={frontmatter} canonicalUrl={canonicalURL} />
		<title>{frontmatter.title} 🚀 {CONFIG.SITE.title}</title>
		<style>
			body {
				width: 100%;
				display: grid;
				grid-template-rows: var(--theme-navbar-height) 1fr;
				--gutter: 0.5rem;
				--doc-padding: 2rem;
			}

			.layout {
				display: grid;
				grid-auto-flow: column;
				grid-template-columns: minmax(var(--gutter), 1fr) minmax(0, var(--max-width)) minmax(
						var(--gutter),
						1fr
					);
				overflow-x: hidden;
			}

			.grid-sidebar {
				position: sticky;
				top: 0;
				padding: 0;
				height: 100%;
			}

			.bg-theme {
				height: fit-content;
			}

			#grid-left {
				position: fixed;
				z-index: 10;
				display: none;
			}

			#grid-main {
				padding: var(--doc-padding) var(--gutter);
				grid-column: 2;
				display: flex;
				flex-direction: column;
			}

			#grid-right {
				display: none;
			}

			@media (min-width: 50em) {
				.layout {
					overflow: initial;
					/* Wider than the single-column MainLayout: two languages need the room. */
					--max-width: min(80rem, calc(100% - 2rem));
					grid-template-columns: 20rem minmax(0, var(--max-width));
					gap: 1em;
				}

				#grid-left {
					display: flex;
					padding-left: 2rem;
					position: sticky;
					grid-column: 1;
				}
			}

			@media (min-width: 72em) {
				.layout {
					--max-width: min(90rem, calc(100% - 38rem));
					grid-template-columns: 20rem minmax(0, var(--max-width)) 18rem;
					padding-left: 0;
					padding-right: 0;
					margin: 0 auto;
				}

				#grid-right {
					grid-column: 3;
					display: flex;
				}
			}
		</style>
		<style is:global>
			.layout > * {
				width: 100%;
				height: 100%;
			}

			.mobile-sidebar-toggle {
				overflow: hidden;
			}

			.mobile-sidebar-toggle #grid-left {
				display: block;
				top: 2rem;
			}
		</style>
	</head>

	<body>
		<div class="min-h-screen flex flex-col justify-between bg-theme">
			<Header currentPage={currentPage} />
			<main class="layout grow">
				<aside id="grid-left" class="grid-sidebar" title="Site Navigation">
					<LeftSidebar currentPage={currentPage} />
				</aside>
				<div id="grid-main">
					<BilingualPageContent
						titleEn={titleEn}
						titleKo={titleKo}
						rows={rows}
						headings={tocHeadings}
						githubEditUrl={githubEditUrl}
						prev={prev}
						next={next}
						basePath={basePath}
						showTitle={showTitle}
						bilingual={bilingual}
						pendingNotice={pendingNotice}
					/>
				</div>
				<aside id="grid-right" class="grid-sidebar">
					<RightSidebar headings={tocHeadings} githubEditUrl={githubEditUrl} />
				</aside>
			</main>
			<Footer />
			<ScrollTopButton />
		</div>
		<AddHeadingScript />
	</body>
</html>
