---
/**
 * 문서 페이지의 뼈대: 머리글(경로 표시) · 왼쪽 자료 목차 · 본문 · 오른쪽 "이 페이지" 목차 · 꼬리글.
 * MainLayout(번역 페이지)과 BilingualLayout(대역 페이지)이 함께 쓴다.
 */
import HeadCommon from '../components/HeadCommon.astro';
import HeadSEO from '../components/HeadSEO.astro';
import Header from '../components/Header/Header.astro';
import LeftSidebar from '../components/LeftSidebar/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar/RightSidebar.astro';
import Footer from '../components/Footer/Footer.astro';
import AddHeadingScript from '../components/AddHeadingScript.astro';
import * as CONFIG from '../config';
import { LIBRARY_HREF, breadcrumb, locate, normalizePath } from '../navigation';
import type { MarkdownHeading } from 'astro';

type Props = {
	frontmatter: CONFIG.Frontmatter;
	headings: MarkdownHeading[];
	githubEditUrl: string;
	/** 경로 표시의 마지막 칸. 메뉴에 없는 페이지일 때 쓴다. */
	pageTitle?: string;
	/** 대역처럼 본문 폭을 넓게 쓴다. */
	wide?: boolean;
};

const { frontmatter, headings, githubEditUrl, pageTitle, wide = false } = Astro.props as Props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPage = Astro.url.pathname;
const topics = CONFIG.SIDEBAR.ko;
const location = locate(topics, currentPage);
const crumbs =
	normalizePath(currentPage) === normalizePath(LIBRARY_HREF)
		? [{ text: '자료실' }]
		: breadcrumb(location, pageTitle ?? frontmatter.title);
---

<html dir={frontmatter.dir ?? 'ltr'} lang={frontmatter.lang ?? 'ko'}>
	<head>
		<HeadCommon />
		<HeadSEO frontmatter={frontmatter} canonicalUrl={canonicalURL} />
		<link rel="me" href="https://dice.camp/@stelo" />
		<title>{frontmatter.title ? `${frontmatter.title} 🚀 ${CONFIG.SITE.title}` : CONFIG.SITE.title}</title>
	</head>

	<body id="top">
		<Header currentPage={currentPage} crumbs={crumbs} />
		<div class:list={['doc', { 'doc--wide': wide }]}>
			<aside class="doc-nav no-print">
				<LeftSidebar topics={topics} location={location} />
			</aside>
			<main class="doc-main">
				<slot />
			</main>
			<aside class="doc-toc no-print">
				<RightSidebar headings={headings} githubEditUrl={githubEditUrl} />
			</aside>
		</div>
		<Footer />
		<AddHeadingScript />
	</body>
</html>

<style>
	.doc {
		display: grid;
		grid-template-columns: var(--sidebar-w) minmax(0, 1fr) var(--toc-w);
		max-width: 92rem;
		margin: 0 auto;
	}

	.doc-nav,
	.doc-toc {
		position: sticky;
		top: var(--header-h);
		align-self: start;
		max-height: calc(100vh - var(--header-h));
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.doc-toc {
		padding: 2.5rem 1.75rem 2.5rem 0;
	}

	.doc-main {
		min-width: 0;
		padding: 2.5rem 3rem 5rem;
	}

	.doc:not(.doc--wide) .doc-main > :global(*) {
		max-width: var(--measure);
	}

	@media (max-width: 72em) {
		.doc {
			grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
		}

		.doc-toc {
			display: none;
		}
	}

	/* 좁은 화면: 왼쪽 메뉴는 머리글 아래로 열리는 서랍이 된다. */
	@media (max-width: 50em) {
		.doc {
			display: block;
		}

		.doc-main {
			padding: 1.5rem 1rem 4rem;
		}

		.doc-nav {
			/* 머리글(z-index 30)이 위를 덮으므로 서랍은 화면 맨 위부터 깔고 머리글 높이만큼 띄운다. */
			position: fixed;
			z-index: 25;
			inset: 0;
			max-height: none;
			padding-top: var(--header-h);
			background: var(--bg);
			visibility: hidden;
			transform: translateX(-100%);
			transition:
				transform 0.2s ease-out,
				visibility 0s linear 0.2s;
		}

		:global(body.nav-open) {
			overflow: hidden;
		}

		:global(body.nav-open) .doc-nav {
			visibility: visible;
			transform: none;
			transition: transform 0.2s ease-out;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.doc-nav {
			transition: none !important;
		}
	}

	@media print {
		.doc {
			display: block;
		}

		.doc-main {
			padding: 0;
		}
	}
</style>
