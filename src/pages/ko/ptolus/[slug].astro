---
import BilingualLayout from '../../../layouts/BilingualLayout.astro';
import { pairSections } from '../../../utils/pairSections';
import { PTOLUS_CHAPTERS, PTOLUS_SOURCE, type PtolusChapterMeta } from '../../../data/ptolus/chapters';

// import.meta.glob은 빌드 청크로 옮겨져도 안전한 정적 import다.
const enSources = import.meta.glob('../../../data/ptolus/en/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const koSources = import.meta.glob('../../../data/ptolus/ko/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

function sourceFor(sources: Record<string, string>, dir: 'en' | 'ko', slug: string): string {
  const source = sources[`../../../data/ptolus/${dir}/${slug}.md`];
  if (source === undefined) {
    if (dir === 'ko') return ''; // 아직 번역하지 않은 장
    throw new Error(`[ptolus:${slug}] en 원문이 없습니다`);
  }
  return source;
}

export function getStaticPaths() {
  return PTOLUS_CHAPTERS.map((chapter, index) => ({
    params: { slug: chapter.slug },
    props: {
      chapter,
      prev: PTOLUS_CHAPTERS[index - 1] ?? null,
      next: PTOLUS_CHAPTERS[index + 1] ?? null,
    } satisfies { chapter: PtolusChapterMeta; prev: PtolusChapterMeta | null; next: PtolusChapterMeta | null },
  }));
}

type Props = {
  chapter: PtolusChapterMeta;
  prev: PtolusChapterMeta | null;
  next: PtolusChapterMeta | null;
};

const { chapter, prev, next } = Astro.props as Props;

const enSource = sourceFor(enSources, 'en', chapter.slug);
const koSource = sourceFor(koSources, 'ko', chapter.slug);
const translated = koSource.trim().length > 0;

const { rows, headings } = pairSections(chapter.slug, enSource, koSource, 'ptolus');
---

<BilingualLayout
  titleEn={chapter.titleEn}
  titleKo={chapter.titleKo}
  titleSuffix="[톨러스]"
  description={`${PTOLUS_SOURCE.titleKo}(${PTOLUS_SOURCE.title}, Monte Cook, ${PTOLUS_SOURCE.year}) "${chapter.titleEn}"의 영어 원문과 한국어 번역 대역`}
  basePath="/ko/ptolus"
  editPath={translated ? `src/data/ptolus/ko/${chapter.slug}.md` : `src/data/ptolus/en/${chapter.slug}.md`}
  rows={rows}
  headings={headings}
  prev={prev}
  next={next}
  showTitle
  bilingual={translated}
  pendingNotice={!translated}
  pendingNoticeHref="/ko/ptolus"
  pendingNoticeLabel="톨러스 목차"
  pendingNoticeSubject="이 장"
/>
