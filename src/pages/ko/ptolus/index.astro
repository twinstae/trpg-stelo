---
import ChapterIndex from '../../../components/PageContent/ChapterIndex.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import { PTOLUS_CHAPTERS, PTOLUS_SOURCE } from '../../../data/ptolus/chapters';

const frontmatter = {
  title: '톨러스 플레이어 가이드 (영/한 대역)',
  description:
    "Monte Cook의 A Player's Guide to Ptolus(2021-03-30판, 34쪽)를 장별로 나눠, 왼쪽에 영어 원문·오른쪽에 한국어 번역을 나란히 보여주는 대역으로 번역합니다.",
  layout: '',
};

const translatedCount = PTOLUS_CHAPTERS.filter((chapter) => chapter.status === 'translated').length;

const parts: { part: string; chapters: typeof PTOLUS_CHAPTERS }[] = [];
for (const chapter of PTOLUS_CHAPTERS) {
  const group = parts.find((entry) => entry.part === chapter.part);
  if (group) group.chapters.push(chapter);
  else parts.push({ part: chapter.part, chapters: [chapter] });
}
---

<MainLayout frontmatter={frontmatter} headings={[]}>
  <p>
    <strong>{PTOLUS_SOURCE.titleKo}</strong>(<a href={PTOLUS_SOURCE.url}>{PTOLUS_SOURCE.title}</a>)는 마법과 모험이
    일상인 도시 톨러스를 소개하는 무료 자료입니다. 이 대역은 {PTOLUS_SOURCE.year}판 {PTOLUS_SOURCE.pageCount}쪽을 장별로 나눠,
    <a href="https://github.com/zerobased-co/muchtrans">muchtrans</a> 방식을 참고해 왼쪽에는 영어 원문을 오른쪽에는
    한국어 번역을 나란히 보여줍니다. 아래 목차에서 장을 골라 볼 수 있습니다. 현재 {PTOLUS_CHAPTERS.length}개 장 가운데{' '}
    {translatedCount}개의 번역을 마쳤습니다.
  </p>
  <p>
    지도와 캐릭터 시트는 <a href="/ko/ptolus/city-map">도시 지도</a>와{' '}
    <a href="/ko/ptolus/character-sheets">캐릭터 시트</a>에서 볼 수 있습니다.
  </p>

  <section class="notice">
    <h2>출처와 권리</h2>
    <p>{PTOLUS_SOURCE.note}</p>
    <p>
      원문은 Monte Cook Games의 <a href={PTOLUS_SOURCE.url}>{PTOLUS_SOURCE.title}</a>이며, Ptolus와 그 로고, 등장인물과
      지명은 Monte J. Cook의 상표입니다. Open Game Content에 해당하는 부분은 Open Game License 1.0a를 따르며, 자세한 내용은{' '}
      <a href="/ko/ptolus/license">라이선스</a> 장에 있습니다.
    </p>
  </section>

  <ChapterIndex
    groups={parts.map(({ part, chapters }) => ({
      title: part,
      chapters: chapters.map((chapter) => ({
        href: `/ko/ptolus/${chapter.slug}`,
        titleKo: chapter.titleKo,
        titleEn: chapter.titleEn,
        status: chapter.status === 'pending' ? '원문만' : undefined,
      })),
    }))}
  />
</MainLayout>
