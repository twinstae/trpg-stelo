---
import SheetLayout from '../../../../../layouts/SheetLayout.astro';
import Dw2PlaybookSheet from '../../../../../components/Sheets/Dw2PlaybookSheet.astro';
import Dw2MovesSheet from '../../../../../components/Sheets/Dw2MovesSheet.astro';
import { DW2_PLAYBOOKS } from '../../../../../data/dw2/playbooks';
import { DW2_MOVE_SHEETS } from '../../../../../data/dw2/moves';

export function getStaticPaths() {
  const playbookPages = DW2_PLAYBOOKS.map((playbook) => ({
    params: { slug: playbook.slug },
    props: { kind: 'playbook' as const, playbook },
  }));
  const movePages = DW2_MOVE_SHEETS.map((group) => ({
    params: { slug: group.slug },
    props: { kind: 'moves' as const, moves: group },
  }));
  return [...playbookPages, ...movePages];
}

const { kind, playbook, moves } = Astro.props as {
  kind: 'playbook' | 'moves';
  playbook?: (typeof DW2_PLAYBOOKS)[number];
  moves?: (typeof DW2_MOVE_SHEETS)[number];
};

const title =
  kind === 'playbook'
    ? `${playbook!.titleKo} 캐릭터 시트 [DW2 2.1]`
    : `${moves!.titleKo} 액션 시트 [DW2 2.1]`;
const description =
  kind === 'playbook'
    ? `던전월드 2 Beta v3 "${playbook!.titleEn}" 직업 플레이북을 캐릭터 시트로 정리한 페이지`
    : `던전월드 2 Beta v3 "${moves!.titleEn}" 액션 참조 시트`;

const chapterSlug = kind === 'playbook' ? playbook!.slug : moves!.slug;
const sheets = [
  { slug: 'core-moves', label: '핵심 액션 시트' },
  { slug: 'extra-moves', label: '추가 액션 시트' },
  { slug: 'magnitude', label: '위력 시트' },
  ...DW2_PLAYBOOKS.map((p) => ({ slug: p.slug, label: `${p.titleKo} 캐릭터 시트` })),
].map((sheet) => ({ ...sheet, href: `/ko/awe/dw2/playbooks/${sheet.slug}` }));

const frontmatter = {
  title,
  description,
  layout: '../../../../../layouts/SheetLayout.astro',
  createdAt: '2026-09-26T00:00:00.000Z',
};
---

<SheetLayout
  frontmatter={frontmatter}
  headings={[]}
  backHref={`/ko/awe/dw2/${chapterSlug}`}
  backLabel={`${kind === 'playbook' ? playbook!.titleKo : moves!.titleKo} 장으로`}
  pageTitle={kind === 'playbook' ? `${playbook!.titleKo} 캐릭터 시트` : `${moves!.titleKo} 액션 시트`}
>
  <label slot="tools" class="sheet-switch">
    <span class="sr-only">다른 시트로 가기</span>
    <select onchange="location.href = this.value">
      {sheets.map((sheet) => (
        <option value={sheet.href} selected={sheet.slug === Astro.params.slug}>
          {sheet.label}
        </option>
      ))}
    </select>
  </label>
  {kind === 'playbook' ? <Dw2PlaybookSheet playbook={playbook!} /> : <Dw2MovesSheet group={moves!} />}
</SheetLayout>

<style>
  .sheet-switch select {
    height: 2.25rem;
    padding: 0 0.5rem;
    border: 0;
    background: var(--bg);
    font-size: 0.875rem;
  }

  .sheet-hint {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
