---
import MainLayout from '../../../layouts/MainLayout.astro';
import { CYPHER_SRD_CHAPTERS } from '../../../data/cypher-srd/chapters';

const frontmatter = {
	title: '사이퍼 시스템 SRD 2026 (영/한 대역)',
	description: '2026-07-29판 사이퍼 시스템 레퍼런스 문서(CSRD)를 영어 원문과 한국어 번역을 나란히 보여주는 대역으로 번역합니다.',
	layout: '',
};
---

<MainLayout frontmatter={frontmatter} headings={[]}>
	<p>
		<a href="https://csol.montecookgames.com/">사이퍼 시스템 오픈 라이선스(CSOL)</a>로 공개된 2026-07-29판 CSRD를
		챕터별로 번역합니다. <a href="https://github.com/zerobased-co/muchtrans">muchtrans</a> 방식을 참고해, 왼쪽에는 영어 원문을
		오른쪽에는 한국어 번역을 문단 단위로 나란히 보여줍니다. 아래 목차에서 번역이 끝난 챕터부터 순서대로 볼 수 있습니다.
	</p>
	<p>
		구판 SRD 번역은 <a href="/ko/cypher-open">사이퍼 SRD</a>에서 계속 볼 수 있습니다. 신판은 챕터 구성이 크게 바뀌어서
		(생물 챕터가 사라지고, 캐릭터 유형·수식어·특징·특수능력이 장르별로 재구성됨) 별도 섹션으로 새로 번역하고 있습니다.
	</p>

	<ol class="chapter-list">
		{
			CYPHER_SRD_CHAPTERS.map((chapter, index) => (
				<li>
					{chapter.status === 'translated' ? (
						<a href={`/ko/cypher-srd/${chapter.slug}`}>
							{index + 1}. {chapter.titleKo} <span class="title-en">{chapter.titleEn}</span>
						</a>
					) : (
						<span class="pending">
							{index + 1}. {chapter.titleKo} <span class="title-en">{chapter.titleEn}</span>
							<span class="status-badge">번역 예정</span>
						</span>
					)}
				</li>
			))
		}
	</ol>
</MainLayout>

<style>
	.chapter-list {
		list-style: none;
		padding-left: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.chapter-list li {
		padding: 0.5rem 0.75rem;
		border-radius: 0.5rem;
		background-color: var(--color-base-200);
	}

	.title-en {
		opacity: 0.6;
		font-size: 0.9em;
		margin-left: 0.25em;
	}

	.pending {
		opacity: 0.6;
	}

	.status-badge {
		margin-left: 0.5em;
		font-size: 0.75em;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.1em 0.5em;
		border-radius: 999em;
		background-color: var(--color-base-300);
	}
</style>
