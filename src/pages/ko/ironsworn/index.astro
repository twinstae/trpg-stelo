---
import MainLayout from '../../../layouts/MainLayout.astro';
import { IRONSWORN_CHAPTERS, IRONSWORN_SOURCE } from '../../../data/ironsworn/chapters';

const frontmatter = {
  title: '철의 맹세 (영/한 대역)',
  description:
    '숀 톰킨의 Ironsworn 규칙서를 장별로 나눠, 왼쪽에 영어 원문·오른쪽에 한국어 번역을 나란히 보여주는 대역으로 번역합니다.',
  layout: '',
};

const translatedCount = IRONSWORN_CHAPTERS.filter((chapter) => chapter.status === 'translated').length;

const parts: { part: string; chapters: typeof IRONSWORN_CHAPTERS }[] = [];
for (const chapter of IRONSWORN_CHAPTERS) {
  const group = parts.find((entry) => entry.part === chapter.part);
  if (group) group.chapters.push(chapter);
  else parts.push({ part: chapter.part, chapters: [chapter] });
}
---

<MainLayout frontmatter={frontmatter} headings={[]}>
  <p>
    <strong>{IRONSWORN_SOURCE.titleKo}</strong>(<a href={IRONSWORN_SOURCE.site}>{IRONSWORN_SOURCE.title}</a>)는 숀 톰킨이
    만들고 혼자서도 플레이할 수 있도록 설계한 다크 판타지 티알피지입니다. 이 대역은 2019년 6월 9일 판 규칙서({IRONSWORN_SOURCE.pageCount}쪽)를
    장별로 나눠, <a href="https://github.com/zerobased-co/muchtrans">muchtrans</a> 방식을 참고해 왼쪽에는 영어 원문을 오른쪽에는
    한국어 번역을 절 단위로 나란히 보여줍니다. 아래 목차에서 번역이 끝난 장부터 순서대로 볼 수 있습니다. 현재{' '}
    {IRONSWORN_CHAPTERS.length}개 단위 가운데 {translatedCount}개의 번역을 마쳤습니다.
  </p>
  <p>
    용어는 <a href="/ko/ironsworn/GLOSSARY">용어집</a>, 표기 규칙은 <a href="/ko/ironsworn/TRANSLATION-GUIDE">번역 지침</a>을
    보십시오. 영어 원문은 규칙서 PDF에서 자동으로 뽑아낸 것이라, 그림이 섞인 쪽은 읽기 순서가 어긋날 수 있습니다.
  </p>

  <section class="notice">
    <h2>출처와 라이선스</h2>
    <p>
      원문은 숀 톰킨의 <a href={IRONSWORN_SOURCE.site}>{IRONSWORN_SOURCE.title}</a>이며,{' '}
      <a href={IRONSWORN_SOURCE.licenseUrl}>{IRONSWORN_SOURCE.license}</a> 라이선스로 공개되어 있습니다.
    </p>
    <blockquote>
      This work is based on <a href={IRONSWORN_SOURCE.site}>Ironsworn</a>, created by Shawn Tomkin, and licensed for our use
      under the <a href={IRONSWORN_SOURCE.licenseUrl}>Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International
      license</a>.
    </blockquote>
    <p class="credit">
      이 작업은 숀 톰킨의 <i>Ironsworn</i> 가운데, 크리에이티브 커먼즈 저작자표시-비영리-동일조건변경허락 4.0 국제 라이선스로 제공되는
      내용을 담고 있습니다. 인쇄용 애셋 카드는 같은 저작자의 <i>Ironsworn Assets</i>(CC BY 4.0)에서 가져왔습니다.
    </p>
  </section>

  {
    parts.map(({ part, chapters }) => (
      <section class="part">
        <h2>{part}</h2>
        <ol class="chapter-list">
          {chapters.map((chapter) => (
            <li>
              <a href={`/ko/ironsworn/${chapter.slug}`}>
                {chapter.titleKo} <span class="title-en">{chapter.titleEn}</span>
              </a>
              {chapter.status === 'pending' && <span class="status-badge">원문만</span>}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</MainLayout>

<style>
  .notice {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    background-color: var(--color-base-200);
    font-size: 0.95em;
  }

  .notice h2 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .notice blockquote {
    margin: 0.75rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--color-base-300);
    opacity: 0.85;
  }

  .credit {
    opacity: 0.75;
  }

  .part {
    margin-top: 2rem;
  }

  .part h2 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .chapter-list {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .chapter-list li {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background-color: var(--color-base-200);
  }

  .title-en {
    opacity: 0.6;
    font-size: 0.9em;
    margin-left: 0.25em;
  }

  .status-badge {
    margin-left: 0.5em;
    font-size: 0.7em;
    letter-spacing: 0.05em;
    padding: 0.1em 0.5em;
    border-radius: 999em;
    background-color: var(--color-base-300);
  }
</style>
