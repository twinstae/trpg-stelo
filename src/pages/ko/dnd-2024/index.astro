---
import ChapterIndex from '../../../components/PageContent/ChapterIndex.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import { DND_2024_CHAPTERS, DND_2024_SOURCE } from '../../../data/dnd-2024/chapters';

const frontmatter = {
  title: 'D&D 2024 SRD 5.2.1 (영/한 대역)',
  description:
    '던전즈 & 드래곤즈 2024년 규칙의 공개 참조 문서(SRD 5.2.1)를 단위별로 나눠, 왼쪽에 영어 원문·오른쪽에 한국어 번역을 나란히 보여주는 대역으로 번역합니다.',
  layout: '',
};

const translatedCount = DND_2024_CHAPTERS.filter((chapter) => chapter.status === 'translated').length;

const parts: { part: string; chapters: typeof DND_2024_CHAPTERS }[] = [];
for (const chapter of DND_2024_CHAPTERS) {
  const group = parts.find((entry) => entry.part === chapter.part);
  if (group) group.chapters.push(chapter);
  else parts.push({ part: chapter.part, chapters: [chapter] });
}
---

<MainLayout frontmatter={frontmatter} headings={[]}>
  <p>
    <strong>{DND_2024_SOURCE.titleKo}</strong>(<a href={DND_2024_SOURCE.url}>{DND_2024_SOURCE.title}</a>)는 2024년판
    던전즈 & 드래곤즈 규칙 가운데 Wizards of the Coast가 {DND_2024_SOURCE.license}로 공개한 부분입니다. 게임 플레이 규칙,
    캐릭터 만들기, 12개 클래스, 배경과 종족, 장비, 주문, 규칙 용어집, 마법 물건, 괴물과 동물이 들어 있습니다. 이 대역은
    <a href="https://github.com/zerobased-co/muchtrans">muchtrans</a> 방식을 참고해 왼쪽에는 영어 원문을 오른쪽에는 한국어
    번역을 나란히 보여줍니다. 현재 {DND_2024_CHAPTERS.length}개 단위 가운데 {translatedCount}개의 번역을 마쳤습니다.
  </p>
  <p>
    번역 규칙과 용어는 <a href="/ko/dnd-2024/TRANSLATION-GUIDE">번역 지침</a>과 <a href="/ko/dnd-2024/GLOSSARY">용어집</a>에
    있습니다.
  </p>

  <section class="notice">
    <h2>출처와 권리</h2>
    <p>
      This work includes material from the System Reference Document 5.2.1 ("SRD 5.2.1") by Wizards of the Coast LLC,
      available at <a href={DND_2024_SOURCE.url}>{DND_2024_SOURCE.url}</a>. The SRD 5.2.1 is licensed under the Creative
      Commons Attribution 4.0 International License, available at
      <a href={DND_2024_SOURCE.licenseUrl}>{DND_2024_SOURCE.licenseUrl}</a>.
    </p>
    <p>
      이 페이지들은 SRD 5.2.1을 한국어로 옮기고 단위별로 나눈 것으로, Wizards of the Coast가 만들거나 승인한 번역이
      아닙니다. 영어 원문은 <a href={DND_2024_SOURCE.markdownUrl}>dnd-5e-srd-markdown</a>의 마크다운 변환본에서 가져왔으며,
      표 모양을 마크다운으로 바꾸고 헤딩에 앵커를 단 것 외에는 고치지 않았습니다. 번역문도 CC BY 4.0을 따릅니다.
    </p>
  </section>

  <ChapterIndex
    groups={parts.map(({ part, chapters }) => ({
      title: part,
      chapters: chapters.map((chapter) => ({
        href: `/ko/dnd-2024/${chapter.slug}`,
        titleKo: chapter.titleKo,
        titleEn: chapter.titleEn,
        status: chapter.status === 'pending' ? '원문만' : undefined,
      })),
    }))}
  />
</MainLayout>
